# Created by .ignore support plugin (hsz.mobi)
### JetBrains template
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio

*.iml
*.log
*.log.gz

mems/

dependency-reduced-pom.xml

logs/

## Directory-based project format:
.idea/
# if you remove the above rule, at least ignore the following:

# User-specific stuff:
# .idea/workspace.xml
# .idea/tasks.xml
# .idea/dictionaries

# Sensitive or high-churn files:
# .idea/dataSources.ids
# .idea/dataSources.xml
# .idea/sqlDataSources.xml
# .idea/dynamic.xml
# .idea/uiDesigner.xml

# Gradle:
# .idea/gradle.xml
# .idea/libraries

# Mongo Explorer plugin:
# .idea/mongoSettings.xml

## File-based project format:
*.ipr
*.iws

## Plugin-specific files:

# IntelliJ
/out/
**/target/
target/

# Eclipse
**/.settings/
.settings/
*.classpath
*.project

# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

# Crashlytics plugin (for Android Studio and IntelliJ)
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
### Linux template
*~

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*
### Java template
*.class

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.ear

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
### macOS template
# Finder's per-folder view settings. Written whenever a directory is opened in
# Finder, so it reappears on its own and rides along in a `git add -A`.
.DS_Store
### Windows template
# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Local development
application-local*.properties
.localenv
volumes/

### Visual Studio Code template
.vscode/
.cdx/
.playwright-mcp/
test-data/**
fe-static/
/dist/
dist/**

#dist
dist-fe/
dist-be/
tmp/

# Plugin runtime binaries are versioned artifacts.
!plugins/*/bin/
!plugins/*/bin/**

# Python bytecode caches (must come after plugin bin un-ignore above)
__pycache__/
**/__pycache__/
*.pyc
test-results/

.worktrees/

# Local superpowers design/plan artifacts - not for this repo
docs/superpowers/

# superpowers brainstorm/sdd scratch (local tooling, never tracked)
.superpowers/

# uv-managed virtualenv (uv.lock is committed for reproducible CI)
.venv/

# Raw coverage profiles. cargo llvm-cov writes these next to the crate when a
# test spawns the binary under test; they are build output, never sources.
*.profraw

# pytest --cov leaves this database in the working directory. dist-exclusions
# is a deny-list over tracked files, so anything committed here reaches the
# public dist by default - a build artifact must not become tracked at all.
.coverage
.coverage.*
htmlcov/
