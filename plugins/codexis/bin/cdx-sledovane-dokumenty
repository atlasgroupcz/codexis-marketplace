#!/usr/bin/env python3
"""cdx-sledovane-dokumenty - track Czech legislation changes via CODEXIS API.

Usage:
    cdx-sledovane-dokumenty add <codexisId> [--parts paragraf1,paragraf2]
    cdx-sledovane-dokumenty remove <codexisId>
    cdx-sledovane-dokumenty list
    cdx-sledovane-dokumenty check [<codexisId>]
    cdx-sledovane-dokumenty confirm <codexisId>
    cdx-sledovane-dokumenty show <codexisId>
    cdx-sledovane-dokumenty group add <codexisId> <groupName>
    cdx-sledovane-dokumenty group remove <codexisId> <groupName>
    cdx-sledovane-dokumenty group list
    cdx-sledovane-dokumenty group delete <groupName>
    cdx-sledovane-dokumenty note add <codexisId> <text>
    cdx-sledovane-dokumenty note list <codexisId>
    cdx-sledovane-dokumenty note remove <codexisId> <index>
    cdx-sledovane-dokumenty related add <codexisId> <type>
    cdx-sledovane-dokumenty related remove <codexisId> <type>
    cdx-sledovane-dokumenty related list <codexisId>
    cdx-sledovane-dokumenty related types <codexisId>
    cdx-sledovane-dokumenty project available
    cdx-sledovane-dokumenty project add [<project>]
    cdx-sledovane-dokumenty project list
    cdx-sledovane-dokumenty project scan|harvest|refresh|show [<project>]
    cdx-sledovane-dokumenty project check [<project>] [--no-notify]
    cdx-sledovane-dokumenty project confirm [<project>] [--act <codexisId>]
    cdx-sledovane-dokumenty project remove [<project>] [--purge]

<project> is a project name, UUID or daemon id; omitted, it is the project the
current chat belongs to.
"""

import argparse
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
CANDIDATES = [
    HERE.parent / "lib",                                  # plugin in-place: bin/.. /lib
    Path.home() / ".local/share/codexis/lib",             # user-local install (XDG)
    Path("/usr/local/share/codexis/lib"),                 # legacy system install
]
for p in CANDIDATES:
    if (p / "sledovane_dokumenty_core").is_dir():
        sys.path.insert(0, str(p))
        break

try:
    from sledovane_dokumenty_core import (
        clients,
        harvest,
        notify,
        project_check,
        projects,
        settings,
        state,
        tracking,
    )
    from sledovane_dokumenty_core import (
        related as related_mod,
    )
    from sledovane_dokumenty_core.exceptions import (
        CdxClientError,
        DocumentError,
    )
except ImportError as e:
    print(f"ERROR: sledovane_dokumenty_core library not found: {e}", file=sys.stderr)
    sys.exit(2)


def err(msg):
    print(f"ERROR: {msg}", file=sys.stderr)


def status(msg):
    print(msg, file=sys.stderr)


def print_progress(msg):
    print(msg, flush=True)


# ── core commands ────────────────────────────────────────────────────────────


def cmd_add(args):
    parts = None
    if args.parts:
        parts = [p.strip() for p in args.parts.split(",") if p.strip()]
    try:
        s = tracking.add(args.codexis_id, parts=parts)
    except tracking.DocumentAlreadyTrackedError:
        status(f"OK: {args.codexis_id} je už sledován (nic k přidání).")
        return
    status(f"OK: Sledování zahájeno pro {s['name']} ({s['codexisId']}).")
    status(f"  Aktuální verze: {s['baseline_version_id']}")
    if s.get("parts"):
        status(f"  Sledované části: {', '.join(s['parts'])}")


def cmd_remove(args):
    try:
        s = tracking.remove(args.codexis_id)
    except tracking.DocumentNotTrackedError:
        status(f"OK: {args.codexis_id} není sledován (nic k odebrání).")
        return
    status(f"OK: Sledování ukončeno pro {s.get('name', args.codexis_id)}.")


def cmd_list(args):
    docs = tracking.list_all()
    if not docs:
        print("Žádné sledované dokumenty.")
        return
    for s in docs:
        cid = s.get("codexisId", "?")
        changes = s.get("changes", [])
        unconfirmed = [c for c in changes if not c.get("confirmed_on")]
        if unconfirmed:
            stav = f"NOVÁ ZMĚNA ({len(unconfirmed)} nepotvrzená/é)"
        elif changes:
            stav = f"potvrzeno ({len(changes)} změn v historii)"
        else:
            stav = "bez změn"
        print(f"  {cid}  {s.get('name', '')}")
        print(
            f"    Baseline: {s.get('baseline_version_id')}  "
            f"Aktuální: {s.get('last_known_version_id')}"
        )
        print(f"    Poslední kontrola: {s.get('last_check_at')}  Stav: {stav}")
        rt = s.get("related_tracking") or {}
        if rt.get("enabled"):
            parts_info = []
            for rtype in rt.get("types", []):
                baseline = state.load_related_baseline(cid, rtype)
                count = (
                    baseline.get("total_count", len(baseline.get("doc_ids", [])))
                    if baseline else "?"
                )
                parts_info.append(f"{rtype} ({count})")
            if parts_info:
                print(f"    Související: {', '.join(parts_info)}")
        print()


def cmd_check(args):
    result = tracking.check(args.codexis_id, printer=print_progress)
    notify_failed = False
    if result.get("changed"):
        from sledovane_dokumenty_core import notify
        # `is False`, not falsy: None means no notification was attempted, which
        # is not a failure. The check is already saved by this point, so the exit
        # code says the user was not told - not that the check failed.
        notify_failed = notify.notify_document_changes(result["changed"])["inApp"] is False
    if result["changes_found"] == 0 and not result["errors"]:
        status("Žádné nové změny.")
    if notify_failed:
        err("Upozornění se nepodařilo odeslat do aplikace.")
        sys.exit(1)


def cmd_confirm(args):
    marked = tracking.confirm(args.codexis_id)
    s = state.load_state(args.codexis_id)
    name = s.get("name", args.codexis_id) if s else args.codexis_id
    if marked == 0:
        status(f"{args.codexis_id}: žádná nepotvrzená změna.")
    else:
        status(
            f"OK: {marked} změna/y potvrzena pro {name}. "
            f"Baseline posunuta na {s['baseline_version_id']}."
        )


def cmd_show(args):
    s = tracking.show(args.codexis_id)
    print(json.dumps(s, indent=2, ensure_ascii=False))


# ── groups ───────────────────────────────────────────────────────────────────


def cmd_group_add(args):
    group_name = " ".join(args.name)
    result = tracking.group_add(args.codexis_id, group_name)
    s = state.load_state(args.codexis_id)
    name = s.get("name", args.codexis_id) if s else args.codexis_id
    if result == "already":
        status(f"{args.codexis_id} je již ve skupině '{group_name}'.")
    else:
        status(f"OK: {name} přidán do skupiny '{group_name}'.")


def cmd_group_remove(args):
    group_name = " ".join(args.name)
    try:
        tracking.group_remove(args.codexis_id, group_name)
    except (tracking.GroupNotFoundError, tracking.DocumentNotTrackedError):
        status(f"OK: {args.codexis_id} není ve skupině '{group_name}' (nic k odebrání).")
        return
    s = state.load_state(args.codexis_id)
    name = s.get("name", args.codexis_id) if s else args.codexis_id
    status(f"OK: {name} odebrán ze skupiny '{group_name}'.")


def cmd_group_delete(args):
    group_name = " ".join(args.name)
    tracking.group_delete(group_name)
    status(f"OK: Skupina '{group_name}' smazána.")


def cmd_group_list(args):
    groups = tracking.groups_list()
    if not groups:
        print("Žádné skupiny.")
        return
    for g in groups:
        members = g.get("members", [])
        print(f"  {g.get('name')} ({g.get('id')}) - {len(members)} dokumentů")
        for cid in members:
            s = state.load_state(cid)
            name = s.get("name", cid) if s else cid
            print(f"    {cid}  {name}")
        print()


# ── notes ────────────────────────────────────────────────────────────────────


def cmd_note_add(args):
    text = " ".join(args.text)
    tracking.note_add(args.codexis_id, text)
    status(f"OK: Poznámka přidána k {args.codexis_id}.")


def cmd_note_list(args):
    notes = tracking.note_list(args.codexis_id)
    s = state.load_state(args.codexis_id)
    name = s.get("name", args.codexis_id) if s else args.codexis_id
    if not notes:
        print(f"Žádné poznámky pro {args.codexis_id}.")
        return
    print(f"Poznámky pro {name} ({args.codexis_id}):")
    for i, note in enumerate(notes):
        print(f"  [{i}] {note}")


def cmd_note_remove(args):
    removed = tracking.note_remove(args.codexis_id, args.index)
    status(f"OK: Poznámka [{args.index}] odstraněna: {removed}")


# ── related ──────────────────────────────────────────────────────────────────


def cmd_related_add(args):
    s = state.load_state(args.codexis_id)
    if s is None:
        err(f"{args.codexis_id} není sledován. Nejdříve přidejte: add {args.codexis_id}")
        sys.exit(1)
    existing = (s.get("related_tracking") or {}).get("types", []) if (
        s.get("related_tracking") or {}
    ).get("enabled") else []
    if args.type in existing:
        status(f"{args.type} už je sledováno pro {args.codexis_id}.")
        return
    status(f"Přidávám sledování {args.type} pro {s.get('name', args.codexis_id)}...")
    related_mod.enable_tracking(args.codexis_id, args.type)
    s = state.load_state(args.codexis_id)
    types = (s.get("related_tracking") or {}).get("types", [])
    status(f"OK: Sledované typy: {', '.join(types)}")


def cmd_related_remove(args):
    s = state.load_state(args.codexis_id)
    if s is None:
        status(f"OK: {args.codexis_id} není sledován (nic k odebrání).")
        return
    existing = (s.get("related_tracking") or {}).get("types", [])
    if args.type not in existing:
        status(f"OK: {args.type} není sledováno pro {args.codexis_id} (nic k odebrání).")
        return
    related_mod.disable_tracking(args.codexis_id, args.type)
    s = state.load_state(args.codexis_id)
    remaining = (s.get("related_tracking") or {}).get("types", [])
    if remaining:
        status(f"OK: {args.type} odebráno. Zbývající typy: {', '.join(remaining)}")
    else:
        status(f"OK: {args.type} odebráno. Sledování related vypnuto.")


def cmd_related_list(args):
    s = state.load_state(args.codexis_id)
    if s is None:
        err(f"{args.codexis_id} není sledován.")
        sys.exit(1)
    name = s.get("name", args.codexis_id)
    rt = s.get("related_tracking") or {}
    print(f"Related tracking pro {name} ({args.codexis_id}):")
    if not rt.get("enabled"):
        print("  Stav: VYPNUTO")
        return
    print("  Stav: ZAPNUTO")
    print(f"  Poslední kontrola: {rt.get('last_check_at', 'N/A')}")
    print("  Sledované typy:")
    for rtype in rt.get("types", []):
        baseline = state.load_related_baseline(args.codexis_id, rtype)
        if baseline:
            count = baseline.get("total_count", len(baseline.get("doc_ids", [])))
            captured = baseline.get("captured_at", "?")
            print(f"    {rtype}: {count} dokumentů (baseline z {captured})")
        else:
            print(f"    {rtype}: bez baseline")


def cmd_related_types(args):
    s = state.load_state(args.codexis_id)
    if s is None:
        err(f"{args.codexis_id} není sledován.")
        sys.exit(1)
    counts = clients.fetch_related_counts(args.codexis_id)
    name = s.get("name", args.codexis_id)
    rt = s.get("related_tracking") or {}
    tracked_types = rt.get("types", []) if rt.get("enabled") else []
    print(f"Typy souvisejících dokumentů pro {name} ({args.codexis_id}):")
    print()
    for item in counts:
        rtype = item.get("type", "?")
        rname = item.get("typeName", rtype)
        rcount = item.get("count", 0)
        tracked = " [SLEDOVÁNO]" if rtype in tracked_types else ""
        print(f"  {rtype}: {rcount} - {rname}{tracked}")
    print()


# ── watched projects ─────────────────────────────────────────────────────────


def _print_json(obj):
    print(json.dumps(obj, indent=2, ensure_ascii=False))


def _project_id(ref):
    return projects.resolve(ref)["projectId"]


def cmd_project_available(args):
    _print_json(projects.available_to_watch())


def cmd_project_add(args):
    res = projects.add_watch(args.project)
    status(f"OK: Sledování projektu „{res['name']}“ zahájeno ({res['projectId']}).")
    if not res["files_available"]:
        status(
            "  Soubory projektu odtud nejsou vidět - naskenují se při extrakci "
            "z aplikace Sledované dokumenty nebo z chatu v tomto projektu."
        )
        return
    status(f"  Dokumentů: {res['total']} ({res['added']} nových).")
    if res.get("total"):
        status(f"  Spusťte extrakci: cdx-sledovane-dokumenty project harvest {res['projectId']}")


def cmd_project_list(args):
    watches = projects.list_watches()
    if not watches:
        print("Žádné sledované projekty.")
        return
    for w in watches:
        print(f"  {w['name']}  ({w['projectId']})")
        print(
            f"    Dokumentů: {w['documents']}  K extrakci: {w['pending_harvest']}  "
            f"Odkazů: {w['legislation']}"
        )
        stav = (
            f"NOVÉ ZMĚNY ({w['unconfirmed_changes']})"
            if w.get("unconfirmed_changes") else "bez změn"
        )
        print(f"    Poslední kontrola: {w.get('last_check_at')}  Stav: {stav}")
        print()


def cmd_project_scan(args):
    _, summary = projects.sync_watched(_project_id(args.project))
    status(
        f"OK: Sken hotov - {summary['total']} dokumentů "
        f"(+{summary['added']} nových, ~{summary['changed']} změněných, "
        f"-{summary['removed']} odebraných)."
    )


def _report_harvest(res):
    suffix = (
        f", {res['failed']} selhalo (zkusí se příště)" if res["failed"] else ""
    )
    status(
        f"OK: Extrakce hotova - {res['documents']} dokumentů, "
        f"{res['references']} odkazů{suffix}."
    )


def cmd_project_harvest(args):
    _report_harvest(harvest.harvest_project(_project_id(args.project), printer=print_progress))


def cmd_project_refresh(args):
    project_id = _project_id(args.project)
    if projects.files_dir(project_id) is not None:
        projects.sync_watched(project_id)
    projects.mark_all_for_reharvest(project_id)
    _report_harvest(harvest.harvest_project(project_id, printer=print_progress))


def cmd_project_check(args):
    project_id = _project_id(args.project) if args.project else None
    result = project_check.check_projects(
        project_id, printer=print_progress, send_notifications=not args.no_notify
    )
    for e in result["errors"]:
        print(f"  ! {e}")
    if result["changes_found"] == 0:
        status("Žádné nové změny legislativy.")
    else:
        status(f"OK: {result['changes_found']} nových změn legislativy.")
    if result["notify_failed"]:
        err("Upozornění se nepodařilo odeslat do aplikace.")
        sys.exit(1)


def cmd_project_show(args):
    project_id = _project_id(args.project)
    _print_json({
        "project": projects.find_in_index(project_id),
        "watched": projects.read_watched(project_id),
        "tracking": projects.read_tracking(project_id),
    })


def cmd_project_confirm(args):
    marked = project_check.confirm_project(_project_id(args.project), args.act)
    status(f"OK: {marked} změn potvrzeno." if marked else "Žádná nepotvrzená změna.")


def cmd_project_remove(args):
    removed = projects.remove_watch(_project_id(args.project), purge=args.purge)
    status("OK: Projekt odebrán ze sledování." if removed else "Projekt nebyl sledován.")


# ── notify (unified) ─────────────────────────────────────────────────────────


def cmd_notify_show(args):
    _print_json(settings.get_notify())


def cmd_notify_set(args):
    eff = settings.set_notify(email=args.email, inApp=args.inapp)
    status(f"OK: Notifikace - e-mail: {eff['email']}, in-app: {eff['inApp']}.")


def cmd_notify_recipients(args):
    current = list(settings.get_notify().get("recipients", []))
    if args.rcmd == "add":
        current.append(args.email.strip())
    elif args.rcmd == "remove":
        current = [r for r in current if r.lower() != args.email.strip().lower()]
    elif args.rcmd == "set":
        current = list(args.emails)
    elif args.rcmd == "clear":
        current = []
    # The signed-in user always receives the e-mail, so drop their own address -
    # listing yourself as an extra is redundant (the FE dialog blocks it too).
    # Say so: dropping the caller's input without a word reads as a silent failure.
    requested = list(current)
    current = notify.without_self(current)
    dropped = [r for r in requested if r not in current]
    try:
        eff = settings.set_notify(recipients=current)
    except ValueError as e:
        err(str(e))
        sys.exit(1)
    if dropped:
        status(
            f"OK: {dropped[0]} vynechán - je to adresa přihlášeného uživatele, "
            f"ten e-mail dostává vždy."
        )
    joined = ", ".join(eff["recipients"]) or "(žádní; e-mail chodí přihlášenému uživateli)"
    status(f"OK: Příjemci - {joined}.")


# ── argparse plumbing ────────────────────────────────────────────────────────


def build_parser():
    p = argparse.ArgumentParser(
        prog="cdx-sledovane-dokumenty",
        description="Track Czech legislation changes via CODEXIS API.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    pa = sub.add_parser("add", help="Start tracking a document")
    pa.add_argument("codexis_id")
    pa.add_argument("--parts", help="Comma-separated [?part=...] element IDs")
    pa.set_defaults(func=cmd_add)

    pr = sub.add_parser("remove", help="Stop tracking")
    pr.add_argument("codexis_id")
    pr.set_defaults(func=cmd_remove)

    pl = sub.add_parser("list", help="List all tracked documents")
    pl.set_defaults(func=cmd_list)

    pc = sub.add_parser("check", help="Check for changes")
    pc.add_argument("codexis_id", nargs="?")
    pc.set_defaults(func=cmd_check)

    pcf = sub.add_parser("confirm", help="Confirm changes + advance baseline")
    pcf.add_argument("codexis_id")
    pcf.set_defaults(func=cmd_confirm)

    ps = sub.add_parser("show", help="Show full state as JSON")
    ps.add_argument("codexis_id")
    ps.set_defaults(func=cmd_show)

    pg = sub.add_parser("group", help="Manage groups")
    pg_sub = pg.add_subparsers(dest="sub", required=True)
    pga = pg_sub.add_parser("add")
    pga.add_argument("codexis_id")
    pga.add_argument("name", nargs="+")
    pga.set_defaults(func=cmd_group_add)
    pgr = pg_sub.add_parser("remove")
    pgr.add_argument("codexis_id")
    pgr.add_argument("name", nargs="+")
    pgr.set_defaults(func=cmd_group_remove)
    pgl = pg_sub.add_parser("list")
    pgl.set_defaults(func=cmd_group_list)
    pgd = pg_sub.add_parser("delete")
    pgd.add_argument("name", nargs="+")
    pgd.set_defaults(func=cmd_group_delete)

    pn = sub.add_parser("note", help="Manage user notes")
    pn_sub = pn.add_subparsers(dest="sub", required=True)
    pna = pn_sub.add_parser("add")
    pna.add_argument("codexis_id")
    pna.add_argument("text", nargs="+")
    pna.set_defaults(func=cmd_note_add)
    pnl = pn_sub.add_parser("list")
    pnl.add_argument("codexis_id")
    pnl.set_defaults(func=cmd_note_list)
    pnr = pn_sub.add_parser("remove")
    pnr.add_argument("codexis_id")
    pnr.add_argument("index", type=int)
    pnr.set_defaults(func=cmd_note_remove)

    prel = sub.add_parser("related", help="Manage related-document tracking")
    prel_sub = prel.add_subparsers(dest="sub", required=True)
    prela = prel_sub.add_parser("add")
    prela.add_argument("codexis_id")
    prela.add_argument("type")
    prela.set_defaults(func=cmd_related_add)
    prelr = prel_sub.add_parser("remove")
    prelr.add_argument("codexis_id")
    prelr.add_argument("type")
    prelr.set_defaults(func=cmd_related_remove)
    prell = prel_sub.add_parser("list")
    prell.add_argument("codexis_id")
    prell.set_defaults(func=cmd_related_list)
    prelt = prel_sub.add_parser("types")
    prelt.add_argument("codexis_id")
    prelt.set_defaults(func=cmd_related_types)

    pp = sub.add_parser("project", help="Watch a project's documents for legislation")
    pp_sub = pp.add_subparsers(dest="sub", required=True)
    project_help = "Project name, UUID or daemon id (default: the current chat's project)"
    ppav = pp_sub.add_parser("available", help="List projects not yet watched (JSON)")
    ppav.set_defaults(func=cmd_project_available)
    ppa = pp_sub.add_parser("add", help="Start watching a project")
    ppa.add_argument("project", nargs="?", help=project_help)
    ppa.set_defaults(func=cmd_project_add)
    ppl = pp_sub.add_parser("list", help="List watched projects")
    ppl.set_defaults(func=cmd_project_list)
    pps = pp_sub.add_parser("scan", help="Rescan files (checksums)")
    pps.add_argument("project", nargs="?", help=project_help)
    pps.set_defaults(func=cmd_project_scan)
    pph = pp_sub.add_parser("harvest", help="AI-extract legislation references")
    pph.add_argument("project", nargs="?", help=project_help)
    pph.set_defaults(func=cmd_project_harvest)
    ppref = pp_sub.add_parser("refresh", help="Force full re-harvest")
    ppref.add_argument("project", nargs="?", help=project_help)
    ppref.set_defaults(func=cmd_project_refresh)
    ppc = pp_sub.add_parser("check", help="Deterministic legislation-change check")
    ppc.add_argument("project", nargs="?", help="Project to check (default: all watched)")
    ppc.add_argument("--no-notify", action="store_true")
    ppc.set_defaults(func=cmd_project_check)
    ppsh = pp_sub.add_parser("show", help="Show watched.json + tracking state as JSON")
    ppsh.add_argument("project", nargs="?", help=project_help)
    ppsh.set_defaults(func=cmd_project_show)
    ppcf = pp_sub.add_parser("confirm", help="Confirm changes + advance baseline")
    ppcf.add_argument("project", nargs="?", help=project_help)
    ppcf.add_argument("--act", help="Confirm only this CODEXIS id")
    ppcf.set_defaults(func=cmd_project_confirm)
    ppr = pp_sub.add_parser("remove", help="Stop watching a project")
    ppr.add_argument("project", nargs="?", help=project_help)
    ppr.add_argument("--purge", action="store_true", help="Also delete the stored state")
    ppr.set_defaults(func=cmd_project_remove)

    pnf = sub.add_parser("notify", help="Manage notification settings")
    pnf_sub = pnf.add_subparsers(dest="sub", required=True)
    pnfs = pnf_sub.add_parser("show")
    pnfs.set_defaults(func=cmd_notify_show)
    pnfset = pnf_sub.add_parser("set")
    pnfset.add_argument("--email", action=argparse.BooleanOptionalAction, default=None)
    pnfset.add_argument("--inapp", action=argparse.BooleanOptionalAction, default=None)
    pnfset.set_defaults(func=cmd_notify_set)

    p_nrec = pnf_sub.add_parser("recipients", help="Manage e-mail recipients")
    nr_sub = p_nrec.add_subparsers(dest="rcmd", required=True)
    nr_add = nr_sub.add_parser("add", help="Add a recipient e-mail")
    nr_add.add_argument("email")
    nr_rm = nr_sub.add_parser("remove", help="Remove a recipient e-mail")
    nr_rm.add_argument("email")
    nr_set = nr_sub.add_parser("set", help="Replace the whole recipient list")
    nr_set.add_argument("emails", nargs="*")
    nr_sub.add_parser("clear", help="Remove all recipients")
    p_nrec.set_defaults(func=cmd_notify_recipients)

    return p


def main():
    parser = build_parser()
    args = parser.parse_args()
    try:
        settings.ensure_settings()
        args.func(args)
    except DocumentError as e:
        err(str(e))
        sys.exit(1)
    except CdxClientError as e:
        err(str(e))
        sys.exit(1)
    except IndexError as e:
        err(str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
