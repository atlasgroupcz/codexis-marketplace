{
  "skills": [
    "register-zmluv:register-zmluv"
  ],
  "env_vars": [
    "CODEXIS_PLUGIN_REGISTER_ZMLUV_API_URL",
    "CODEXIS_USER_API_TOKEN"
  ],
  "post_install": [
    {
      "type": "file",
      "path": "$HOME/.local/bin/register-zmluv"
    }
  ],
  "post_uninstall": [
    {
      "type": "absent",
      "path": "$HOME/.local/bin/register-zmluv"
    }
  ]
}
