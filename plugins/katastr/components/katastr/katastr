#!/usr/bin/env bash
# Platform dispatcher. The CGI handler (JSON dispatch, POST actions) lives in
# the native Rust binary - this script exists solely to pick the right build for
# the host. The HTML shell (index.html) is served by cdx-daemon's SpaCgi runtime
# directly, so the binary never runs for HTML requests.
#
# Linux x86_64 is the default (unsuffixed `katastr-cgi`, matching the naming
# used by sibling Rust plugins). Additional targets live next to it with
# Rust-target-triple suffixes.
#
# Uses bash parameter expansion and $OSTYPE/$HOSTTYPE builtins instead of
# $(cd && pwd) / $(uname); each subshell would add ~3-5ms of fork/exec overhead
# that dominates the sub-2ms Rust runtime.
set -euo pipefail

SCRIPT_DIR="${BASH_SOURCE[0]%/*}"

case "${OSTYPE}:${HOSTTYPE}" in
    darwin*:arm64*|darwin*:aarch64*)
        exec "${SCRIPT_DIR}/katastr-cgi-aarch64-apple-darwin" "$@" ;;
    linux-gnu:x86_64*)
        exec "${SCRIPT_DIR}/katastr-cgi" "$@" ;;
    *)
        printf 'Status: 500 Internal Server Error\r\n'
        printf 'Content-Type: application/json; charset=utf-8\r\n\r\n'
        printf '{"ok":false,"error":"Unsupported platform: %s:%s"}' "${OSTYPE}" "${HOSTTYPE}"
        exit 0
        ;;
esac
