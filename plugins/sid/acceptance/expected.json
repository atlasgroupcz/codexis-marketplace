{
  "skills": [
    "sid:sid"
  ],
  "env_vars": [
    "CODEXIS_PLUGIN_SID_API_URL"
  ],
  "post_install": [
    {
      "type": "file",
      "path": "$HOME/.local/bin/sid-cli"
    },
    {
      "type": "file",
      "path": "$HOME/.local/share/sid/settings/defaults.json"
    }
  ],
  "post_uninstall": [
    {
      "type": "absent",
      "path": "$HOME/.local/bin/sid-cli"
    },
    {
      "type": "absent",
      "path": "$HOME/.local/share/sid/settings/defaults.json"
    }
  ]
}
