#!/usr/bin/env node

// src/config.ts
var import_node_fs = require("node:fs");
var import_node_path = require("node:path");
var import_node_os = require("node:os");
var EXIT = { OK: 0, ERROR: 1, USAGE: 2, AUTH: 3, NOT_FOUND: 4, RATE_LIMIT: 5 };
var DEFAULT_BASE_URL = "https://sid.onprem.agrp.dev";
function userHome() {
  return process.env.CODEXIS_PUBLIC_USER_HOME || import_node_os.homedir();
}
function envFilePath() {
  return process.env.SID_ENV_FILE || import_node_path.join(userHome(), ".cdx", "apps", "sid", ".env");
}
function readEnvFile() {
  const out = {};
  try {
    for (const line of import_node_fs.readFileSync(envFilePath(), "utf8").split(`
`)) {
      const t = line.trim();
      if (!t || t.startsWith("#") || !t.includes("="))
        continue;
      const i = t.indexOf("=");
      out[t.slice(0, i).trim()] = t.slice(i + 1).trim();
    }
  } catch {}
  return out;
}
function getApiKey() {
  return readEnvFile().SID_API_KEY ?? "";
}
function getBaseUrl() {
  const raw = process.env.CODEXIS_PLUGIN_SID_API_URL || readEnvFile().SID_API_URL || DEFAULT_BASE_URL;
  return raw.trim().replace(/\/+$/, "");
}
function writeEnvFile(entries) {
  const path = envFilePath();
  import_node_fs.mkdirSync(import_node_path.dirname(path), { recursive: true, mode: 448 });
  const body = Object.entries(entries).map(([k, v]) => `${k}=${v}`).join(`
`) + `
`;
  const tmp = `${path}.tmp-${process.pid}`;
  import_node_fs.writeFileSync(tmp, body, { mode: 384 });
  import_node_fs.renameSync(tmp, path);
}
function writeEnvValue(key, value) {
  writeEnvFile({ ...readEnvFile(), [key]: value });
}
function writeApiKey(key) {
  writeEnvFile({ ...readEnvFile(), SID_API_KEY: key });
}
function deleteApiKey() {
  const rest = readEnvFile();
  delete rest.SID_API_KEY;
  if (Object.keys(rest).length === 0) {
    if (import_node_fs.existsSync(envFilePath()))
      import_node_fs.rmSync(envFilePath());
    return;
  }
  writeEnvFile(rest);
}

// src/http.ts
class CliError extends Error {
  exitCode;
  constructor(message, exitCode) {
    super(message);
    this.exitCode = exitCode;
  }
}
var NO_KEY_MSG = "API klíč není nastaven. Vygenerujte si ho v SID (Profil → API klíče, " + "/api-klice) a vložte v nastavení pluginu SID v aplikaci Codexis.";
function statusToError(status, bodyText) {
  const detail = bodyText.slice(0, 300);
  if (status === 401) {
    return new CliError(`SID odmítl API klíč (401). Klíč vypršel nebo byl zrušen — vydejte nový na /api-klice. ${detail}`, EXIT.AUTH);
  }
  if (status === 403)
    return new CliError(`Přístup odepřen (403). ${detail}`, EXIT.AUTH);
  if (status === 404)
    return new CliError(`Nenalezeno (404). ${detail}`, EXIT.NOT_FOUND);
  if (status === 429) {
    return new CliError(`Rate limit SID (429) — zpomalte; search je 60 požadavků/min. ${detail}`, EXIT.RATE_LIMIT);
  }
  return new CliError(`SID vrátil HTTP ${status}. ${detail}`, EXIT.ERROR);
}
var REQUEST_TIMEOUT_MS = 30000;
var DOWNLOAD_TIMEOUT_MS = 15 * 60000;
async function request(path, init, f, keyOverride, timeoutMs = REQUEST_TIMEOUT_MS) {
  const key = keyOverride ?? getApiKey();
  if (!key)
    throw new CliError(NO_KEY_MSG, EXIT.AUTH);
  const res = await f(`${getBaseUrl()}${path}`, {
    ...init,
    signal: AbortSignal.timeout(timeoutMs),
    headers: { ...init.headers ?? {}, "x-api-key": key }
  }).catch((e) => {
    const name = e instanceof Error ? e.name : "";
    if (name === "TimeoutError" || name === "AbortError") {
      throw new CliError(`Požadavek na SID vypršel (${timeoutMs / 1000} s) — server neodpovídá.`, EXIT.ERROR);
    }
    throw new CliError(`SID není dostupný (${e instanceof Error ? e.message : String(e)}).`, EXIT.ERROR);
  });
  if (!res.ok)
    throw statusToError(res.status, await res.text().catch(() => ""));
  return res;
}
async function parseJson(res) {
  const text = await res.text();
  try {
    return JSON.parse(text);
  } catch {
    throw new CliError(`Odpověď ze SID není JSON — zkontrolujte adresu (${getBaseUrl()}); ` + `server vrátil: ${text.slice(0, 120).replace(/\s+/g, " ").trim()}`, EXIT.ERROR);
  }
}
async function apiGet(path, f = fetch, keyOverride) {
  return parseJson(await request(path, {}, f, keyOverride));
}

// src/notify.ts
var import_node_fs3 = require("node:fs");
var import_node_path3 = require("node:path");

// src/notify-settings.ts
var import_node_fs2 = require("node:fs");
var import_node_path2 = require("node:path");
var import_node_os2 = require("node:os");
var BUILTIN = { email: false, inApp: true, recipients: [] };
function defaultsPath() {
  return process.env.SID_DEFAULTS_FILE || import_node_path2.join(import_node_os2.homedir(), ".local", "share", "sid", "settings", "defaults.json");
}
function userSettingsPath() {
  return import_node_path2.join(userHome(), ".cdx", "apps", "sid", "settings.json");
}
function isEmail(value) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value.trim());
}
function writeNotifyOverride(patch) {
  const path = userSettingsPath();
  const current = readJson(path) ?? {};
  const currentNotify = current.notify && typeof current.notify === "object" ? current.notify : {};
  const next = { ...current, notify: { ...currentNotify, ...patch } };
  import_node_fs2.mkdirSync(import_node_path2.dirname(path), { recursive: true, mode: 448 });
  const tmp = `${path}.tmp-${process.pid}`;
  import_node_fs2.writeFileSync(tmp, JSON.stringify(next, null, 2) + `
`, { mode: 384 });
  import_node_fs2.renameSync(tmp, path);
}
function readJson(path) {
  try {
    const parsed = JSON.parse(import_node_fs2.readFileSync(path, "utf8"));
    return parsed && typeof parsed === "object" ? parsed : null;
  } catch {
    return null;
  }
}
function cleanRecipients(raw) {
  if (!Array.isArray(raw))
    return;
  return raw.filter((v) => typeof v === "string").map((v) => v.trim()).filter(Boolean);
}
function notifyBlock(source) {
  const raw = source?.notify;
  if (!raw || typeof raw !== "object")
    return {};
  const out = {};
  const { email, inApp, recipients } = raw;
  if (typeof email === "boolean")
    out.email = email;
  if (typeof inApp === "boolean")
    out.inApp = inApp;
  const cleaned = cleanRecipients(recipients);
  if (cleaned)
    out.recipients = cleaned;
  return out;
}
function getNotifySettings() {
  return {
    ...BUILTIN,
    ...notifyBlock(readJson(defaultsPath())),
    ...notifyBlock(readJson(userSettingsPath()))
  };
}

// src/notify.ts
var GRAPHQL_PATH = "/graphql";
var ME_QUERY_TIMEOUT_MS = 1e4;
function graphqlUrl(daemonUrl) {
  const base = (daemonUrl || "").replace(/\/+$/, "");
  return base.endsWith(GRAPHQL_PATH) ? base : base + GRAPHQL_PATH;
}
function daemonAuth() {
  try {
    let t = import_node_fs3.readFileSync(import_node_path3.join(userHome(), ".cdx", "env", "secret"), "utf8").trim();
    if (!t)
      return null;
    if (t.toLowerCase().startsWith("authorization:"))
      t = t.slice("authorization:".length).trim();
    return t.toLowerCase().startsWith("bearer ") ? t : `Bearer ${t}`;
  } catch {
    return null;
  }
}
async function queryMeEmail(auth, daemonUrl, f) {
  try {
    const res = await f(graphqlUrl(daemonUrl), {
      method: "POST",
      signal: AbortSignal.timeout(ME_QUERY_TIMEOUT_MS),
      headers: { authorization: auth, "content-type": "application/json" },
      body: JSON.stringify({ query: "query { me { email } }" })
    });
    if (!res.ok)
      return null;
    const data = await res.json();
    const email = data?.data?.me?.email;
    return typeof email === "string" && email ? email : null;
  } catch {
    return null;
  }
}
async function currentUserEmail(f = fetch) {
  const cached = readEnvFile().SID_USER_EMAIL;
  if (cached)
    return cached;
  const daemonUrl = process.env.CODEXIS_PUBLIC_DAEMON_URL;
  const auth = daemonAuth();
  if (!daemonUrl || !auth)
    return "";
  const email = await queryMeEmail(auth, daemonUrl, f);
  if (!email)
    return "";
  writeEnvValue("SID_USER_EMAIL", email);
  return email;
}

// src/cgi.ts
async function status(f) {
  const key = getApiKey();
  return {
    ok: true,
    configured: key !== "",
    baseUrl: getBaseUrl(),
    ...key ? { start: key.slice(0, 7) } : {},
    userEmail: await currentUserEmail(f),
    notify: getNotifySettings()
  };
}
async function handle(body, f = fetch) {
  switch (body.action) {
    case "get_status":
      return status(f);
    case "save_config": {
      const key = (body.api_key ?? "").trim();
      if (!key)
        return { ok: false, error: "Vložte API klíč." };
      let me;
      try {
        me = await apiGet("/api/v1/users/me", f, key);
      } catch (e) {
        const err = e;
        return {
          ok: false,
          error: err.exitCode === EXIT.AUTH ? "SID klíč odmítl — zkontrolujte, že je zkopírovaný celý a že nevypršel." : `Klíč se nepodařilo ověřit (SID neodpovědělo): ${err.message}`
        };
      }
      writeApiKey(key);
      writeEnvValue("SID_USER_ROLE", me.role === "ADMIN" ? "ADMIN" : "USER");
      return { ok: true, verified: true, start: key.slice(0, 7) };
    }
    case "save_notify_settings": {
      const patch = {};
      if (typeof body.email === "boolean")
        patch.email = body.email;
      if (typeof body.inApp === "boolean")
        patch.inApp = body.inApp;
      if (Array.isArray(body.recipients)) {
        const invalid = body.recipients.filter((r) => typeof r !== "string" || r.trim() !== "" && !isEmail(r));
        if (invalid.length > 0) {
          return { ok: false, error: `Neplatná e-mailová adresa: ${invalid.map(String).join(", ")}` };
        }
        patch.recipients = body.recipients.filter((r) => typeof r === "string").map((r) => r.trim()).filter(Boolean);
      }
      writeNotifyOverride(patch);
      return { ok: true, notify: getNotifySettings() };
    }
    case "delete_config":
      deleteApiKey();
      return { ok: true };
    default:
      return { ok: false, error: `Neznámá akce '${body.action ?? ""}'.` };
  }
}
function renderCgi(payload, cgiStatus) {
  const head = (cgiStatus ? `Status: ${cgiStatus}\r
` : "") + `Content-Type: application/json; charset=utf-8\r
` + `Cache-Control: no-store\r
`;
  return `${head}\r
${JSON.stringify(payload, null, 2)}`;
}
async function readStdin() {
  const declared = Number(process.env.CONTENT_LENGTH ?? "0");
  if (!Number.isFinite(declared) || declared <= 0)
    return "";
  const chunks = [];
  for await (const c of process.stdin)
    chunks.push(c);
  return Buffer.concat(chunks).toString("utf8");
}
async function serve(f = fetch) {
  const method = (process.env.REQUEST_METHOD ?? "GET").toUpperCase();
  try {
    if (method !== "POST")
      return renderCgi(await status(f));
    const raw = await readStdin();
    let body;
    try {
      body = raw ? JSON.parse(raw) : {};
    } catch {
      return renderCgi({ ok: false, error: "Neplatné JSON tělo." }, "400 Bad Request");
    }
    return renderCgi(await handle(body, f));
  } catch (e) {
    return renderCgi({ ok: false, error: `Interní chyba: ${e instanceof Error ? e.message : String(e)}` }, "500 Internal Server Error");
  }
}

// src/cgi-main.ts
serve().then((out) => process.stdout.write(out));
