#!/usr/bin/env node
var __defProp = Object.defineProperty;
var __export = (target, all) => {
  for (var name in all)
    __defProp(target, name, {
      get: all[name],
      enumerable: true,
      configurable: true,
      set: (newValue) => all[name] = () => newValue
    });
};
var __esm = (fn, res) => () => (fn && (res = fn(fn = 0)), res);

// src/config.ts
function userHome() {
  return process.env.CODEXIS_PUBLIC_USER_HOME || import_node_os.homedir();
}
function envFilePath() {
  return process.env.SID_ENV_FILE || import_node_path.join(userHome(), ".cdx", "apps", "sid", ".env");
}
function readEnvFile() {
  const out = {};
  try {
    for (const line of import_node_fs.readFileSync(envFilePath(), "utf8").split(`
`)) {
      const t = line.trim();
      if (!t || t.startsWith("#") || !t.includes("="))
        continue;
      const i = t.indexOf("=");
      out[t.slice(0, i).trim()] = t.slice(i + 1).trim();
    }
  } catch {}
  return out;
}
function getApiKey() {
  return readEnvFile().SID_API_KEY ?? "";
}
function isPlausibleApiKey(key) {
  return key.length > 0 && !/\s/.test(key);
}
function getBaseUrl() {
  const raw = process.env.CODEXIS_PLUGIN_SID_API_URL || readEnvFile().SID_API_URL || DEFAULT_BASE_URL;
  return raw.trim().replace(/\/+$/, "");
}
function writeEnvFile(entries) {
  for (const [k, v] of Object.entries(entries)) {
    if (/[\r\n]/.test(k) || /[\r\n]/.test(v)) {
      throw new Error(`Odmítnut zápis do .env: hodnota '${k}' obsahuje konec řádku.`);
    }
  }
  const path = envFilePath();
  import_node_fs.mkdirSync(import_node_path.dirname(path), { recursive: true, mode: 448 });
  const body = Object.entries(entries).map(([k, v]) => `${k}=${v}`).join(`
`) + `
`;
  const tmp = `${path}.tmp-${process.pid}`;
  import_node_fs.writeFileSync(tmp, body, { mode: 384 });
  import_node_fs.renameSync(tmp, path);
}
function writeEnvValue(key, value) {
  writeEnvFile({ ...readEnvFile(), [key]: value });
}
function writeApiKey(key) {
  writeEnvFile({ ...readEnvFile(), SID_API_KEY: key });
}
function deleteApiKey() {
  const rest = readEnvFile();
  delete rest.SID_API_KEY;
  delete rest.SID_USER_ROLE;
  delete rest.SID_USER_EMAIL;
  if (Object.keys(rest).length === 0) {
    if (import_node_fs.existsSync(envFilePath()))
      import_node_fs.rmSync(envFilePath());
    return;
  }
  writeEnvFile(rest);
}
var import_node_fs, import_node_path, import_node_os, EXIT, DEFAULT_BASE_URL = "https://sid.onprem.agrp.dev";
var init_config = __esm(() => {
  import_node_fs = require("node:fs");
  import_node_path = require("node:path");
  import_node_os = require("node:os");
  EXIT = {
    OK: 0,
    ERROR: 1,
    USAGE: 2,
    AUTH: 3,
    NOT_FOUND: 4,
    RATE_LIMIT: 5,
    FORBIDDEN: 6
  };
});

// src/http.ts
function statusToError(status, bodyText) {
  const detail = bodyText.slice(0, 300);
  if (status === 401) {
    return new CliError(`SID odmítl API klíč (401). Klíč vypršel nebo byl zrušen - vydejte nový na /api-klice. ${detail}`, EXIT.AUTH);
  }
  if (status === 403) {
    return new CliError(`Přístup odepřen (403). SID vrací 403 i na id, které nezná, takže neplatné id ` + `a chybějící oprávnění od sebe nerozliší - ověřte id; pokud sedí, nemáte k záznamu přístup. ${detail}`, EXIT.FORBIDDEN);
  }
  if (status === 404)
    return new CliError(`Nenalezeno (404). ${detail}`, EXIT.NOT_FOUND);
  if (status === 429) {
    return new CliError(`Rate limit SID (429) - zpomalte; search je 60 požadavků/min. ${detail}`, EXIT.RATE_LIMIT);
  }
  return new CliError(`SID vrátil HTTP ${status}. ${detail}`, EXIT.ERROR);
}
function networkError(e, timeoutMs) {
  const name = e instanceof Error ? e.name : "";
  if (name === "TimeoutError" || name === "AbortError") {
    throw new CliError(`Požadavek na SID vypršel (${timeoutMs / 1000} s) - server neodpovídá.`, EXIT.ERROR);
  }
  throw new CliError(`SID není dostupný (${e instanceof Error ? e.message : String(e)}).`, EXIT.ERROR);
}
async function request(path, init, f, keyOverride, timeoutMs = REQUEST_TIMEOUT_MS) {
  const key = keyOverride ?? getApiKey();
  if (!key)
    throw new CliError(NO_KEY_MSG, EXIT.AUTH);
  const res = await f(`${getBaseUrl()}${path}`, {
    ...init,
    signal: AbortSignal.timeout(timeoutMs),
    headers: { ...init.headers ?? {}, "x-api-key": key }
  }).catch((e) => networkError(e, timeoutMs));
  if (!res.ok)
    throw statusToError(res.status, await res.text().catch(() => ""));
  return res;
}
async function parseJson(res) {
  const text = await res.text();
  try {
    return JSON.parse(text);
  } catch {
    throw new CliError(`Odpověď ze SID není JSON - zkontrolujte adresu (${getBaseUrl()}); ` + `server vrátil: ${text.slice(0, 120).replace(/\s+/g, " ").trim()}`, EXIT.ERROR);
  }
}
async function apiGet(path, f = fetch, keyOverride) {
  return parseJson(await request(path, {}, f, keyOverride));
}
async function apiPatch(path, body, f = fetch) {
  return parseJson(await request(path, { method: "PATCH", body: JSON.stringify(body), headers: { "content-type": "application/json" } }, f));
}
async function apiRaw(path, f = fetch, timeoutMs = DOWNLOAD_TIMEOUT_MS) {
  const key = getApiKey();
  if (!key)
    throw new CliError(NO_KEY_MSG, EXIT.AUTH);
  const url = `${getBaseUrl()}${path}`;
  const res = await f(url, {
    signal: AbortSignal.timeout(timeoutMs),
    redirect: "manual",
    headers: { "x-api-key": key }
  }).catch((e) => networkError(e, timeoutMs));
  if (res.status >= 300 && res.status < 400) {
    const location = res.headers.get("location");
    if (!location)
      throw new CliError(`SID vrátil přesměrování bez cíle (HTTP ${res.status}).`, EXIT.ERROR);
    const target = new URL(location, url).toString();
    const followed = await f(target, {
      signal: AbortSignal.timeout(timeoutMs),
      redirect: "follow"
    }).catch((e) => networkError(e, timeoutMs));
    if (!followed.ok)
      throw statusToError(followed.status, await followed.text().catch(() => ""));
    return followed;
  }
  if (!res.ok)
    throw statusToError(res.status, await res.text().catch(() => ""));
  return res;
}
var CliError, NO_KEY_MSG, REQUEST_TIMEOUT_MS = 30000, DOWNLOAD_TIMEOUT_MS;
var init_http = __esm(() => {
  init_config();
  CliError = class CliError extends Error {
    exitCode;
    constructor(message, exitCode) {
      super(message);
      this.exitCode = exitCode;
    }
  };
  NO_KEY_MSG = "API klíč není nastaven. Vygenerujte si ho v SID (Profil → API klíče, " + "/api-klice) a vložte v nastavení pluginu SID v aplikaci Codexis.";
  DOWNLOAD_TIMEOUT_MS = 15 * 60000;
});

// src/links.ts
function documentUrl(documentId, role) {
  const base = role === "ADMIN" ? "/admin/files" : "/files";
  return `${getBaseUrl()}${base}/${encodeURIComponent(documentId)}`;
}
function homeUrl() {
  return getBaseUrl();
}
function confirmationsUrl(role) {
  return `${getBaseUrl()}${role === "ADMIN" ? "/admin/confirmations" : "/confirmations"}`;
}
function folderUrl(folderId, role) {
  const base = role === "ADMIN" ? "/admin/files" : "/files";
  return `${getBaseUrl()}${base}?folderId=${encodeURIComponent(folderId)}`;
}
async function resolveRole(f) {
  const cached = readEnvFile().SID_USER_ROLE;
  if (cached === "ADMIN" || cached === "USER")
    return cached;
  try {
    const me = await apiGet("/api/v1/users/me", f);
    const role = me?.role === "ADMIN" ? "ADMIN" : "USER";
    writeEnvValue("SID_USER_ROLE", role);
    return role;
  } catch {
    return null;
  }
}
var init_links = __esm(() => {
  init_http();
  init_config();
});

// src/commands/search.ts
var exports_search = {};
__export(exports_search, {
  run: () => run
});
async function run(argv, f) {
  const { values, positionals } = import_node_util.parseArgs({
    args: argv,
    allowPositionals: true,
    options: { size: { type: "string", default: "10" }, from: { type: "string" } }
  });
  const q = positionals.join(" ").trim();
  if (!q)
    throw new CliError("Použití: sid-cli search <dotaz> [--size N] [--from N]", EXIT.USAGE);
  const sp = new URLSearchParams({ q, size: String(values.size) });
  if (values.from)
    sp.set("from", String(values.from));
  const res = await apiGet(`/api/search?${sp}`, f);
  const role = await resolveRole(f);
  const hits = (res.hits ?? []).map((h) => h.documentId ? { ...h, url: documentUrl(h.documentId, role) } : h);
  if (res.source === "opensearch_unavailable") {
    return {
      ...res,
      hits,
      warning: "Fulltext je dočasně nedostupný (opensearch_unavailable) - prázdný výsledek NEZNAMENÁ, " + "že nic neexistuje. Zkuste to později nebo použijte `sid-cli docs list --query`."
    };
  }
  return { ...res, hits };
}
var import_node_util;
var init_search = __esm(() => {
  init_http();
  init_config();
  init_links();
  import_node_util = require("node:util");
});

// src/commands/docs.ts
var exports_docs = {};
__export(exports_docs, {
  run: () => run2
});
async function run2(argv, f) {
  const [sub, ...rest] = argv;
  if (sub === "get") {
    const id = rest[0];
    if (!id)
      throw new CliError(USAGE, EXIT.USAGE);
    const doc = await apiGet(`/api/v1/documents/${encodeURIComponent(id)}`, f);
    return { ...doc, url: documentUrl(doc.id ?? id, await resolveRole(f)) };
  }
  if (sub === "legislation") {
    const id = rest[0];
    if (!id)
      throw new CliError(USAGE, EXIT.USAGE);
    const legislation = await apiGet(`/api/v1/documents/${encodeURIComponent(id)}/legislation`, f);
    return { documentId: id, legislation };
  }
  if (sub === "set-validity") {
    const id = rest[0];
    if (!id)
      throw new CliError(USAGE, EXIT.USAGE);
    const { values } = import_node_util2.parseArgs({
      args: rest.slice(1),
      options: {
        from: { type: "string" },
        to: { type: "string" },
        "clear-from": { type: "boolean", default: false },
        "clear-to": { type: "boolean", default: false }
      }
    });
    const patch = {};
    for (const [flag, field, clearFlag] of [
      ["from", "effectiveFrom", "clear-from"],
      ["to", "effectiveTo", "clear-to"]
    ]) {
      const raw = values[flag];
      const clear = values[clearFlag];
      if (raw !== undefined && clear) {
        throw new CliError(`--${flag} a --${clearFlag} nelze zadat naráz: buď datum nastavte, nebo ho smažte.`, EXIT.USAGE);
      }
      if (raw !== undefined) {
        if (!ISO_DATE.test(raw)) {
          throw new CliError(`Datum musí být ve formátu YYYY-MM-DD, dostal jsem '${raw}'.`, EXIT.USAGE);
        }
        patch[field] = raw;
      } else if (clear) {
        patch[field] = null;
      }
    }
    if (Object.keys(patch).length === 0) {
      throw new CliError("Nebylo co nastavit - uveďte --from, --to, --clear-from nebo --clear-to.", EXIT.USAGE);
    }
    return apiPatch(`/api/v1/documents/${encodeURIComponent(id)}`, patch, f);
  }
  if (sub === "list") {
    const { values } = import_node_util2.parseArgs({
      args: rest,
      options: {
        query: { type: "string" },
        folder: { type: "string" },
        author: { type: "string" },
        sort: { type: "string" },
        page: { type: "string" },
        "page-size": { type: "string" },
        attribute: { type: "string", multiple: true },
        from: { type: "string" },
        to: { type: "string" },
        type: { type: "string" },
        personal: { type: "boolean", default: false }
      }
    });
    for (const flag of ["from", "to"]) {
      const v = values[flag];
      if (v !== undefined && !ISO_DATE.test(v)) {
        throw new CliError(`--${flag} musí být ve formátu YYYY-MM-DD, dostal jsem '${v}'.`, EXIT.USAGE);
      }
    }
    const sp = new URLSearchParams;
    if (values.query)
      sp.set("query", values.query);
    if (values.folder)
      sp.set("folderId", values.folder);
    if (values.author)
      sp.set("authorId", values.author);
    if (values.sort)
      sp.set("sortBy", values.sort);
    if (values.from)
      sp.set("dateFrom", values.from);
    if (values.to)
      sp.set("dateTo", values.to);
    if (values.type)
      sp.set("mimeType", values.type);
    if (values.personal)
      sp.set("personalOnly", "true");
    if (values.page)
      sp.set("page", values.page);
    if (values["page-size"])
      sp.set("pageSize", values["page-size"]);
    for (const id of values.attribute ?? [])
      sp.append("attributeIds", id);
    const qs = sp.toString();
    const res = await apiGet(`/api/v1/documents${qs ? `?${qs}` : ""}`, f);
    const role = await resolveRole(f);
    return {
      ...res,
      documents: (res.documents ?? []).map((d) => d.id ? { ...d, url: documentUrl(d.id, role) } : d)
    };
  }
  throw new CliError(USAGE, EXIT.USAGE);
}
var import_node_util2, ISO_DATE, USAGE;
var init_docs = __esm(() => {
  init_http();
  init_config();
  init_links();
  import_node_util2 = require("node:util");
  ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
  USAGE = "Použití: sid-cli docs list [--query T] [--folder ID] [--author ID] [--attribute ID]… " + "[--from YYYY-MM-DD] [--to YYYY-MM-DD] [--type pdf|word|excel|image] [--personal] " + `[--sort newest|oldest|title|size] [--page N] [--page-size N]
` + `         sid-cli docs get <id>
` + `         sid-cli docs legislation <id>
` + "         sid-cli docs set-validity <id> [--from YYYY-MM-DD] [--to YYYY-MM-DD] [--clear-from] [--clear-to]";
});

// src/commands/folders.ts
var exports_folders = {};
__export(exports_folders, {
  run: () => run3
});
function pathOf(folder, byId) {
  const names = [];
  let current = folder;
  const seen = new Set;
  while (current && !seen.has(current.id)) {
    seen.add(current.id);
    names.unshift(current.name);
    current = current.parentId ? byId.get(current.parentId) : undefined;
  }
  return names.join(" / ");
}
async function run3(argv, f) {
  if (argv[0] !== "list")
    throw new CliError(USAGE2, EXIT.USAGE);
  const folders = await apiGet("/api/v1/folders", f);
  const byId = new Map(folders.map((x) => [x.id, x]));
  const role = await resolveRole(f);
  return {
    folders: folders.map((x) => ({ ...x, path: pathOf(x, byId), url: folderUrl(x.id, role) })).sort((a, b) => a.path.localeCompare(b.path, "cs"))
  };
}
var USAGE2 = "Použití: sid-cli folders list";
var init_folders = __esm(() => {
  init_http();
  init_config();
  init_links();
});

// src/commands/access.ts
var exports_access = {};
__export(exports_access, {
  run: () => run4
});
function matchAll(items, pick, needle) {
  const n = needle.trim().toLowerCase();
  return items.filter((x) => (pick(x) ?? "").trim().toLowerCase() === n);
}
async function resolveUser(needle, f) {
  if (UUID.test(needle))
    return { id: needle };
  const users = await apiGet("/api/v1/users", f);
  const byEmail = matchAll(users, (u) => u.email, needle);
  const hits = byEmail.length > 0 ? byEmail : matchAll(users, (u) => u.name, needle);
  if (hits.length === 0) {
    throw new CliError(`Uživatel '${needle}' nenalezen - zadejte e-mail nebo id.`, EXIT.NOT_FOUND);
  }
  if (hits.length > 1) {
    const opts = hits.map((u) => u.email ?? u.id).join(", ");
    throw new CliError(`'${needle}' odpovídá více uživatelům - upřesněte e-mailem nebo id: ${opts}`, EXIT.USAGE);
  }
  return hits[0];
}
async function resolveGroup(needle, f) {
  if (UUID.test(needle))
    return { id: needle };
  const groups = await apiGet("/api/v1/groups", f);
  const hits = matchAll(groups, (g) => g.name, needle);
  if (hits.length === 0)
    throw new CliError(`Skupina '${needle}' nenalezena.`, EXIT.NOT_FOUND);
  if (hits.length > 1) {
    throw new CliError(`'${needle}' odpovídá více skupinám - upřesněte id: ${hits.map((g) => g.id).join(", ")}`, EXIT.USAGE);
  }
  return hits[0];
}
function folderLabel(x) {
  return x.folderPath.map((p) => p.name).join(" / ") || x.folderName;
}
async function run4(argv, f) {
  const [sub] = argv;
  const needle = argv.slice(1).join(" ").trim();
  if (sub !== "user" && sub !== "group" || !needle)
    throw new CliError(USAGE3, EXIT.USAGE);
  const role = await resolveRole(f);
  if (sub === "user") {
    const u = await resolveUser(needle, f);
    const res2 = await apiGet(`/api/v1/access/users/${encodeURIComponent(u.id)}`, f);
    const folders2 = res2.folders.map((x) => ({
      folder: folderLabel(x),
      role: x.role,
      source: x.source,
      url: folderUrl(x.folderId, role)
    }));
    return {
      user: { id: u.id, ...u.email ? { email: u.email } : {}, ...u.name ? { name: u.name } : {} },
      folders: folders2,
      ...folders2.length === 0 ? { note: EMPTY_NOTE } : {}
    };
  }
  const g = await resolveGroup(needle, f);
  const res = await apiGet(`/api/v1/access/groups/${encodeURIComponent(g.id)}`, f);
  const folders = res.folders.map((x) => ({
    folder: folderLabel(x),
    role: x.role,
    ...x.deny ? { deny: true } : {},
    url: folderUrl(x.folderId, role)
  }));
  return {
    group: { id: g.id, ...g.name ? { name: g.name } : {} },
    folders,
    ...folders.length === 0 ? { note: EMPTY_NOTE } : {}
  };
}
var USAGE3 = "Použití: sid-cli access user <email|jméno|id> | access group <název|id>", UUID, EMPTY_NOTE = "Žádné složky: principal nikde nemá přístup, nebo na dané složky nemáte admin právo. Práva se upravují v SID.";
var init_access = __esm(() => {
  init_http();
  init_config();
  init_links();
  UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
});

