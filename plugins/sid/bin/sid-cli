  run: () => run3
});
function folderUrl(id, role) {
  const base = role === "ADMIN" ? "/admin/files" : "/files";
  return `${getBaseUrl()}${base}?folderId=${encodeURIComponent(id)}`;
}
function pathOf(folder, byId) {
  const names = [];
  let current = folder;
  const seen = new Set;
  while (current && !seen.has(current.id)) {
    seen.add(current.id);
    names.unshift(current.name);
    current = current.parentId ? byId.get(current.parentId) : undefined;
  }
  return names.join(" / ");
}
async function run3(argv, f) {
  if (argv[0] !== "list")
    throw new CliError(USAGE2, EXIT.USAGE);
  const folders = await apiGet("/api/v1/folders", f);
  const byId = new Map(folders.map((x) => [x.id, x]));
  const role = await resolveRole(f);
  return {
    folders: folders.map((x) => ({ ...x, path: pathOf(x, byId), url: folderUrl(x.id, role) })).sort((a, b) => a.path.localeCompare(b.path, "cs"))
  };
}
var USAGE2 = "Použití: sid-cli folders list";
var init_folders = __esm(() => {
  init_http();
  init_config();
  init_links();
});

