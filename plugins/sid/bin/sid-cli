#!/usr/bin/env node
var __defProp = Object.defineProperty;
var __export = (target, all) => {
  for (var name in all)
    __defProp(target, name, {
      get: all[name],
      enumerable: true,
      configurable: true,
      set: (newValue) => all[name] = () => newValue
    });
};
var __esm = (fn, res) => () => (fn && (res = fn(fn = 0)), res);

// src/config.ts
function userHome() {
  return process.env.CODEXIS_PUBLIC_USER_HOME || import_node_os.homedir();
}
function envFilePath() {
  return process.env.SID_ENV_FILE || import_node_path.join(userHome(), ".cdx", "apps", "sid", ".env");
}
function readEnvFile() {
  const out = {};
  try {
    for (const line of import_node_fs.readFileSync(envFilePath(), "utf8").split(`
`)) {
      const t = line.trim();
      if (!t || t.startsWith("#") || !t.includes("="))
        continue;
      const i = t.indexOf("=");
      out[t.slice(0, i).trim()] = t.slice(i + 1).trim();
    }
  } catch {}
  return out;
}
function getApiKey() {
  return readEnvFile().SID_API_KEY ?? "";
}
function getBaseUrl() {
  const raw = process.env.CODEXIS_PLUGIN_SID_API_URL || readEnvFile().SID_API_URL || DEFAULT_BASE_URL;
  return raw.trim().replace(/\/+$/, "");
}
function writeEnvFile(entries) {
  const path = envFilePath();
  import_node_fs.mkdirSync(import_node_path.dirname(path), { recursive: true, mode: 448 });
  const body = Object.entries(entries).map(([k, v]) => `${k}=${v}`).join(`
`) + `
`;
  const tmp = `${path}.tmp-${process.pid}`;
  import_node_fs.writeFileSync(tmp, body, { mode: 384 });
  import_node_fs.renameSync(tmp, path);
}
function writeEnvValue(key, value) {
  writeEnvFile({ ...readEnvFile(), [key]: value });
}
function writeApiKey(key) {
  writeEnvFile({ ...readEnvFile(), SID_API_KEY: key });
}
function deleteApiKey() {
  const rest = readEnvFile();
  delete rest.SID_API_KEY;
  if (Object.keys(rest).length === 0) {
    if (import_node_fs.existsSync(envFilePath()))
      import_node_fs.rmSync(envFilePath());
    return;
  }
  writeEnvFile(rest);
}
var import_node_fs, import_node_path, import_node_os, EXIT, DEFAULT_BASE_URL = "https://sid.onprem.agrp.dev";
var init_config = __esm(() => {
  import_node_fs = require("node:fs");
  import_node_path = require("node:path");
  import_node_os = require("node:os");
  EXIT = { OK: 0, ERROR: 1, USAGE: 2, AUTH: 3, NOT_FOUND: 4, RATE_LIMIT: 5 };
});

// src/http.ts
function statusToError(status, bodyText) {
  const detail = bodyText.slice(0, 300);
  if (status === 401) {
    return new CliError(`SID odmítl API klíč (401). Klíč vypršel nebo byl zrušen — vydejte nový na /api-klice. ${detail}`, EXIT.AUTH);
  }
  if (status === 403)
    return new CliError(`Přístup odepřen (403). ${detail}`, EXIT.AUTH);
  if (status === 404)
    return new CliError(`Nenalezeno (404). ${detail}`, EXIT.NOT_FOUND);
  if (status === 429) {
    return new CliError(`Rate limit SID (429) — zpomalte; search je 60 požadavků/min. ${detail}`, EXIT.RATE_LIMIT);
  }
  return new CliError(`SID vrátil HTTP ${status}. ${detail}`, EXIT.ERROR);
}
async function request(path, init, f, keyOverride, timeoutMs = REQUEST_TIMEOUT_MS) {
  const key = keyOverride ?? getApiKey();
  if (!key)
    throw new CliError(NO_KEY_MSG, EXIT.AUTH);
  const res = await f(`${getBaseUrl()}${path}`, {
    ...init,
    signal: AbortSignal.timeout(timeoutMs),
    headers: { ...init.headers ?? {}, "x-api-key": key }
  }).catch((e) => {
    const name = e instanceof Error ? e.name : "";
    if (name === "TimeoutError" || name === "AbortError") {
      throw new CliError(`Požadavek na SID vypršel (${timeoutMs / 1000} s) — server neodpovídá.`, EXIT.ERROR);
    }
    throw new CliError(`SID není dostupný (${e instanceof Error ? e.message : String(e)}).`, EXIT.ERROR);
  });
  if (!res.ok)
    throw statusToError(res.status, await res.text().catch(() => ""));
  return res;
}
async function parseJson(res) {
  const text = await res.text();
  try {
    return JSON.parse(text);
  } catch {
    throw new CliError(`Odpověď ze SID není JSON — zkontrolujte adresu (${getBaseUrl()}); ` + `server vrátil: ${text.slice(0, 120).replace(/\s+/g, " ").trim()}`, EXIT.ERROR);
  }
}
async function apiGet(path, f = fetch, keyOverride) {
  return parseJson(await request(path, {}, f, keyOverride));
}
async function apiRaw(path, f = fetch, timeoutMs = DOWNLOAD_TIMEOUT_MS) {
  return request(path, {}, f, undefined, timeoutMs);
}
var CliError, NO_KEY_MSG, REQUEST_TIMEOUT_MS = 30000, DOWNLOAD_TIMEOUT_MS;
var init_http = __esm(() => {
  init_config();
  CliError = class CliError extends Error {
    exitCode;
    constructor(message, exitCode) {
      super(message);
      this.exitCode = exitCode;
    }
  };
  NO_KEY_MSG = "API klíč není nastaven. Vygenerujte si ho v SID (Profil → API klíče, " + "/api-klice) a vložte v nastavení pluginu SID v aplikaci Codexis.";
  DOWNLOAD_TIMEOUT_MS = 15 * 60000;
});

// src/links.ts
function documentUrl(documentId, role) {
  const base = role === "ADMIN" ? "/admin/files" : "/files";
  return `${getBaseUrl()}${base}/${encodeURIComponent(documentId)}`;
}
function confirmationsUrl(role) {
  return `${getBaseUrl()}${role === "ADMIN" ? "/admin/confirmations" : "/confirmations"}`;
}
async function resolveRole(f) {
  const cached = readEnvFile().SID_USER_ROLE;
  if (cached === "ADMIN" || cached === "USER")
    return cached;
  try {
    const me = await apiGet("/api/v1/users/me", f);
    const role = me?.role === "ADMIN" ? "ADMIN" : "USER";
    writeEnvValue("SID_USER_ROLE", role);
    return role;
  } catch {
    return null;
  }
}
var init_links = __esm(() => {
  init_http();
  init_config();
});

// src/commands/search.ts
var exports_search = {};
__export(exports_search, {
  run: () => run
});
async function run(argv, f) {
  const { values, positionals } = import_node_util.parseArgs({
    args: argv,
    allowPositionals: true,
    options: { size: { type: "string", default: "10" }, from: { type: "string" } }
  });
  const q = positionals.join(" ").trim();
  if (!q)
    throw new CliError("Použití: sid-cli search <dotaz> [--size N] [--from N]", EXIT.USAGE);
  const sp = new URLSearchParams({ q, size: String(values.size) });
  if (values.from)
    sp.set("from", String(values.from));
  const res = await apiGet(`/api/search?${sp}`, f);
  const role = await resolveRole(f);
  const hits = res.hits.map((h) => h.documentId ? { ...h, url: documentUrl(h.documentId, role) } : h);
  if (res.source === "opensearch_unavailable") {
    return {
      ...res,
      hits,
      warning: "Fulltext je dočasně nedostupný (opensearch_unavailable) — prázdný výsledek NEZNAMENÁ, " + "že nic neexistuje. Zkuste to později nebo použijte `sid-cli docs list --query`."
    };
  }
  return { ...res, hits };
}
var import_node_util;
var init_search = __esm(() => {
  init_http();
  init_config();
  init_links();
  import_node_util = require("node:util");
});

// src/commands/docs.ts
var exports_docs = {};
__export(exports_docs, {
  run: () => run2
});
async function run2(argv, f) {
  const [sub, ...rest] = argv;
  if (sub === "get") {
    const id = rest[0];
    if (!id)
      throw new CliError(USAGE, EXIT.USAGE);
    const doc = await apiGet(`/api/v1/documents/${encodeURIComponent(id)}`, f);
    return { ...doc, url: documentUrl(doc.id ?? id, await resolveRole(f)) };
  }
  if (sub === "list") {
    const { values } = import_node_util2.parseArgs({
      args: rest,
      options: {
        query: { type: "string" },
        folder: { type: "string" },
        author: { type: "string" },
        sort: { type: "string" },
        page: { type: "string" },
        "page-size": { type: "string" },
        attribute: { type: "string", multiple: true },
        from: { type: "string" },
        to: { type: "string" },
        type: { type: "string" },
        personal: { type: "boolean", default: false }
      }
    });
    const sp = new URLSearchParams;
    if (values.query)
      sp.set("query", values.query);
    if (values.folder)
      sp.set("folderId", values.folder);
    if (values.author)
      sp.set("authorId", values.author);
    if (values.sort)
      sp.set("sortBy", values.sort);
    if (values.from)
      sp.set("dateFrom", values.from);
    if (values.to)
      sp.set("dateTo", values.to);
    if (values.type)
      sp.set("mimeType", values.type);
    if (values.personal)
      sp.set("personalOnly", "true");
    if (values.page)
      sp.set("page", values.page);
    if (values["page-size"])
      sp.set("pageSize", values["page-size"]);
    for (const id of values.attribute ?? [])
      sp.append("attributeIds", id);
    const qs = sp.toString();
    const res = await apiGet(`/api/v1/documents${qs ? `?${qs}` : ""}`, f);
    const role = await resolveRole(f);
    return {
      ...res,
      documents: (res.documents ?? []).map((d) => d.id ? { ...d, url: documentUrl(d.id, role) } : d)
    };
  }
  throw new CliError(USAGE, EXIT.USAGE);
}
var import_node_util2, USAGE;
var init_docs = __esm(() => {
  init_http();
  init_config();
  init_links();
  import_node_util2 = require("node:util");
  USAGE = "Použití: sid-cli docs list [--query T] [--folder ID] [--author ID] [--attribute ID]… " + "[--from YYYY-MM-DD] [--to YYYY-MM-DD] [--type pdf|word|excel|image] [--personal] " + "[--sort newest|oldest|title|size] [--page N] [--page-size N] | sid-cli docs get <id>";
});

// src/commands/folders.ts
var exports_folders = {};
