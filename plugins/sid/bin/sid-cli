// src/notify-settings.ts
function defaultsPath() {
  return process.env.SID_DEFAULTS_FILE || import_node_path3.join(import_node_os2.homedir(), ".local", "share", "sid", "settings", "defaults.json");
}
function userSettingsPath() {
  return import_node_path3.join(userHome(), ".cdx", "apps", "sid", "settings.json");
}
function readJson(path) {
  try {
    const parsed = JSON.parse(import_node_fs3.readFileSync(path, "utf8"));
    return parsed && typeof parsed === "object" ? parsed : null;
  } catch {
    return null;
  }
}
function notifyBlock(source) {
  const raw = source?.notify;
  if (!raw || typeof raw !== "object")
    return {};
  const { inApp } = raw;
  return typeof inApp === "boolean" ? { inApp } : {};
}
function getNotifySettings() {
  return {
    ...BUILTIN,
    ...notifyBlock(readJson(defaultsPath())),
    ...notifyBlock(readJson(userSettingsPath()))
  };
}
var import_node_fs3, import_node_path3, import_node_os2, BUILTIN;
var init_notify_settings = __esm(() => {
  init_config();
  import_node_fs3 = require("node:fs");
  import_node_path3 = require("node:path");
  import_node_os2 = require("node:os");
  BUILTIN = { inApp: true };
});

// src/notify.ts
function graphqlUrl(daemonUrl) {
  const base = (daemonUrl || "").replace(/\/+$/, "");
  return base.endsWith(GRAPHQL_PATH) ? base : base + GRAPHQL_PATH;
}
function daemonAuth() {
  try {
    let t = import_node_fs4.readFileSync(import_node_path4.join(userHome(), ".cdx", "env", "secret"), "utf8").trim();
    if (!t)
      return null;
    if (t.toLowerCase().startsWith("authorization:"))
      t = t.slice("authorization:".length).trim();
    t = t.replace(/[\r\n]/g, "");
    if (!t)
      return null;
    return t.toLowerCase().startsWith("bearer ") ? t : `Bearer ${t}`;
  } catch {
    return null;
  }
}
async function sendBell(message, auth, daemonUrl, f, target) {
  const query = "mutation Create($input: CreateNotificationInput!) { createNotification(input: $input) { id } }";
  const input = { message, type: "sid-update" };
  if (target.link)
    input.link = target.link;
  try {
    const res = await f(graphqlUrl(daemonUrl), {
      method: "POST",
      signal: AbortSignal.timeout(DAEMON_TIMEOUT_MS),
      headers: { authorization: auth, "content-type": "application/json; charset=utf-8" },
      body: JSON.stringify({ query, variables: { input } })
    });
    if (!res.ok)
      return false;
    const payload = await res.json();
    if (typeof payload !== "object" || payload === null || Array.isArray(payload))
      return false;
    return !payload.errors;
  } catch {
    return false;
  }
}
async function sendDigest(message, f = fetch, target = {}) {
  const daemonUrl = process.env.CODEXIS_PUBLIC_DAEMON_URL;
  const auth = daemonAuth();
  if (!daemonUrl || !auth)
    return false;
  if (!getNotifySettings().inApp)
    return false;
  return sendBell(message, auth, daemonUrl, f, target);
}
var import_node_fs4, import_node_path4, GRAPHQL_PATH = "/graphql", DAEMON_TIMEOUT_MS = 30000;
var init_notify = __esm(() => {
  init_config();
  init_notify_settings();
  import_node_fs4 = require("node:fs");
  import_node_path4 = require("node:path");
});

// src/commands/check.ts
var exports_check = {};
__export(exports_check, {
  run: () => run9
});
async function run9(argv, f) {
  const { values } = import_node_util7.parseArgs({ args: argv, options: { notify: { type: "boolean", default: false } } });
  const [notifications, confirmations] = await Promise.all([
    apiGet("/api/notifications?unreadOnly=true&limit=50", f),
    apiGet("/api/v1/confirmations?state=pending", f)
  ]);
  const role = await resolveRole(f);
  const withUrl = (items) => items.map((i) => i.documentId ? { ...i, url: documentUrl(i.documentId, role) } : i);
  const digest = {
    unreadNotifications: notifications.length,
    pendingConfirmations: confirmations.length,
    notifications: withUrl(notifications),
    confirmations: withUrl(confirmations),
    confirmInApp: confirmationsUrl(role),
    notified: false
  };
  if (values.notify && (digest.unreadNotifications > 0 || digest.pendingConfirmations > 0)) {
    const link = digest.pendingConfirmations > 0 ? confirmationsUrl(role) : homeUrl();
    const message = `SID: ${digest.unreadNotifications} nových notifikací, ${digest.pendingConfirmations} čekajících potvrzení`;
    digest.notified = await sendDigest(message, f, { link });
  }
  return digest;
}
var import_node_util7;
var init_check = __esm(() => {
  init_http();
  init_notify();
  init_links();
  import_node_util7 = require("node:util");
});

// src/commands/settings.ts
var exports_settings = {};
__export(exports_settings, {
  run: () => run10
});
function isAdmin(role) {
  return role === "ADMIN";
}
async function readStdin() {
  const chunks = [];
  for await (const c of process.stdin)
    chunks.push(c);
  return Buffer.concat(chunks).toString("utf8");
}
async function verifyKey(key, f) {
  try {
    return await apiGet("/api/v1/users/me", f, key);
  } catch (e) {
    const err = e;
    const code = err.exitCode ?? EXIT.ERROR;
    const reason = code === EXIT.AUTH ? `SID klíč odmítl - zkontrolujte, že je zkopírovaný celý a že nevypršel. ${err.message}` : `Klíč se nepodařilo ověřit (SID neodpovědělo): ${err.message}`;
    throw new CliError(`${reason} Původní nastavení zůstalo beze změny.`, code);
  }
}
async function run10(argv, f, stdin = readStdin) {
  const [sub] = argv;
  if (sub === "set-key") {
    const key = (await stdin()).trim();
    if (!key)
      throw new CliError(`Na STDIN nepřišel žádný klíč. ${USAGE6}`, EXIT.USAGE);
    if (!isPlausibleApiKey(key)) {
      throw new CliError("Klíč obsahuje nepovolené znaky (mezera/konec řádku) - vložte jen samotný klíč.", EXIT.USAGE);
    }
    const user = await verifyKey(key, f);
    writeApiKey(key);
    writeEnvValue("SID_USER_ROLE", user?.role === "ADMIN" ? "ADMIN" : "USER");
    return { verified: true, user, start: key.slice(0, 7) };
  }
  if (sub === "test") {
    const user = await apiGet("/api/v1/users/me", f);
    return { ok: true, user };
  }
  if (sub === "whoami") {
    const user = await apiGet("/api/v1/users/me", f);
    const admin = isAdmin(user.role);
    return {
      userId: user.id,
      email: user.email,
      name: user.name,
      role: admin ? "ADMIN" : "USER",
      isAdmin: admin
    };
  }
  if (sub === "status") {
    const key = getApiKey();
    const cachedRole = readEnvFile().SID_USER_ROLE;
    return {
      configured: key !== "",
      baseUrl: getBaseUrl(),
      ...key ? { start: key.slice(0, 7) } : {},
      ...cachedRole ? { role: cachedRole, isAdmin: isAdmin(cachedRole) } : {}
    };
  }
  if (sub === "delete-key") {
    deleteApiKey();
    return { deleted: true };
  }
  throw new CliError(USAGE6, EXIT.USAGE);
}
var USAGE6;
var init_settings = __esm(() => {
  init_http();
  init_config();
  USAGE6 = "Použití: sid-cli settings set-key|test|status|whoami|delete-key  " + "(set-key čte klíč ze STDIN: echo KLIC | sid-cli settings set-key)";
});

// src/main.ts
init_http();
init_config();
var COMMANDS = {
  search: () => Promise.resolve().then(() => (init_search(), exports_search)),
  docs: () => Promise.resolve().then(() => (init_docs(), exports_docs)),
  folders: () => Promise.resolve().then(() => (init_folders(), exports_folders)),
  access: () => Promise.resolve().then(() => (init_access(), exports_access)),
  attributes: () => Promise.resolve().then(() => (init_attributes(), exports_attributes)),
  download: () => Promise.resolve().then(() => (init_download(), exports_download)),
  confirmations: () => Promise.resolve().then(() => (init_confirmations(), exports_confirmations)),
  notifications: () => Promise.resolve().then(() => (init_notifications(), exports_notifications)),
  check: () => Promise.resolve().then(() => (init_check(), exports_check)),
  settings: () => Promise.resolve().then(() => (init_settings(), exports_settings))
};
var HELP = `sid-cli - přístup k SID (Systém interních dokumentů) přes API klíč

Příkazy:
  search <dotaz> [--size N]                fulltextové hledání
  docs list [--query|--folder|--attribute…] výpis dokumentů s filtry
  docs get <id>                            metadata dokumentu
  docs legislation <id>                    sledovaná legislativa dokumentu
  docs set-validity <id> --from|--to       datum platnosti (nutné EDITOR právo)
  folders list                             složky, do kterých vidím
  access user|group <email|název|id>       (admin) jaká práva má user/skupina ke složkám
  attributes list [--all]                  katalog atributů pro filtrování
  download <fileId|documentId> [--out CESTA]  stažení souboru
  confirmations list [--state pending]     co mám potvrdit (potvrzuje se v SID)
  notifications [--all] [--limit N]        notifikace (default nepřečtené)
  check [--notify]                         digest: novinky + čekající potvrzení
  settings set-key|test|status             správa klíče (set-key čte STDIN)
  settings whoami                          kdo jsem a jestli jsem admin

Klíč: vygenerujte v SID na /api-klice, vložte v panelu pluginu.
Ukládá se do ~/.cdx/apps/sid/.env - nikdy ho nevkládejte do chatu.`;
async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  if (!cmd || cmd === "--help" || cmd === "help") {
    console.log(HELP);
    return;
  }
  const loader = COMMANDS[cmd];
  if (!loader)
    throw new CliError(`Neznámý příkaz '${cmd}'.

${HELP}`, EXIT.USAGE);
  const command = await loader();
  let result;
  try {
    result = await command.run(rest);
  } catch (e) {
    const code = e.code;
    if (typeof code === "string" && code.startsWith("ERR_PARSE_ARGS")) {
      throw new CliError(`${e.message}

sid-cli ${cmd} --help`, EXIT.USAGE);
    }
    throw e;
  }
  if (result !== undefined)
    process.stdout.write(JSON.stringify(result, null, 2) + `
`);
}
main().catch((err) => {
  if (err instanceof CliError) {
    process.stderr.write(err.message + `
`);
    process.exitCode = err.exitCode;
  } else {
    process.stderr.write(`Neočekávaná chyba: ${err instanceof Error ? err.message : String(err)}
`);
    process.exitCode = EXIT.ERROR;
  }
});
