// src/commands/download.ts
var exports_download = {};
__export(exports_download, {
  run: () => run6
});
function filenameFrom(res, fileId) {
  const cd = res.headers.get("content-disposition") ?? "";
  const m = /filename="?([^";]+)"?/.exec(cd);
  const raw = m?.[1] ?? fileId;
  const safe = import_node_path2.basename(raw.trim().replace(/\\/g, "/"));
  return safe && safe !== "." && safe !== ".." ? safe : import_node_path2.basename(fileId) || "stazeny-soubor";
}
async function currentFileIdOf(documentId, f) {
  try {
    const doc = await apiGet(`/api/v1/documents/${encodeURIComponent(documentId)}`, f);
    return doc.currentFile?.id ?? null;
  } catch (e) {
    if (e instanceof CliError && (e.exitCode === EXIT.FORBIDDEN || e.exitCode === EXIT.NOT_FOUND)) {
      return null;
    }
    throw e;
  }
}
async function fetchFile(id, f) {
  try {
    return { res: await apiRaw(`/api/files/download/${encodeURIComponent(id)}`, f), fileId: id };
  } catch (e) {
    if (!(e instanceof CliError) || e.exitCode !== EXIT.FORBIDDEN)
      throw e;
    const resolved = await currentFileIdOf(id, f);
    if (!resolved)
      throw e;
    return {
      res: await apiRaw(`/api/files/download/${encodeURIComponent(resolved)}`, f),
      fileId: resolved
    };
  }
}
async function run6(argv, f) {
  const { values, positionals } = import_node_util4.parseArgs({
    args: argv,
    allowPositionals: true,
    options: { out: { type: "string" } }
  });
  const id = positionals[0];
  if (!id) {
    throw new CliError("Použití: sid-cli download <fileId|documentId> [--out CESTA]", EXIT.USAGE);
  }
  const { res, fileId } = await fetchFile(id, f);
  const target = import_node_path2.resolve(values.out ?? filenameFrom(res, fileId));
  if (!res.body)
    throw new CliError("Prázdná odpověď serveru.", EXIT.ERROR);
  import_node_fs2.mkdirSync(import_node_path2.dirname(target), { recursive: true });
  await import_promises.pipeline(import_node_stream.Readable.fromWeb(res.body), import_node_fs2.createWriteStream(target));
  return { savedTo: target, bytes: import_node_fs2.statSync(target).size };
}
var import_node_util4, import_node_fs2, import_node_stream, import_promises, import_node_path2;
var init_download = __esm(() => {
  init_http();
  init_config();
  import_node_util4 = require("node:util");
  import_node_fs2 = require("node:fs");
  import_node_stream = require("node:stream");
  import_promises = require("node:stream/promises");
  import_node_path2 = require("node:path");
});

// src/commands/confirmations.ts
var exports_confirmations = {};
__export(exports_confirmations, {
  run: () => run7
});
async function run7(argv, f) {
  const [sub, ...rest] = argv;
  if (sub === "confirm") {
    throw new CliError("Potvrzení se provádí v aplikaci SID, ne z příkazové řádky - " + "otevřete dokument v SID a potvrďte ho tam. " + `Seznam čekajících: ${confirmationsUrl(await resolveRole(f))}`, EXIT.USAGE);
  }
  if (sub === "list") {
    const { values } = import_node_util5.parseArgs({ args: rest, options: { state: { type: "string" } } });
    if (values.state !== undefined && values.state !== "pending" && values.state !== "confirmed") {
      throw new CliError(`--state musí být 'pending' nebo 'confirmed', dostal jsem '${values.state}'.`, EXIT.USAGE);
    }
    const qs = values.state ? `?state=${encodeURIComponent(values.state)}` : "";
    const items = await apiGet(`/api/v1/confirmations${qs}`, f);
    const role = await resolveRole(f);
    return {
      confirmations: items.map((c) => c.documentId ? { ...c, url: documentUrl(c.documentId, role) } : c),
      confirmInApp: confirmationsUrl(role)
    };
  }
  throw new CliError(USAGE5, EXIT.USAGE);
}
var import_node_util5, USAGE5 = "Použití: sid-cli confirmations list [--state pending|confirmed]";
