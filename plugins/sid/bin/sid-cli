#!/usr/bin/env node
var __defProp = Object.defineProperty;
var __export = (target, all) => {
  for (var name in all)
    __defProp(target, name, {
      get: all[name],
      enumerable: true,
      configurable: true,
      set: (newValue) => all[name] = () => newValue
    });
};
var __esm = (fn, res) => () => (fn && (res = fn(fn = 0)), res);

// src/config.ts
function userHome() {
  return process.env.CODEXIS_PUBLIC_USER_HOME || import_node_os.homedir();
}
function envFilePath() {
  return process.env.SID_ENV_FILE || import_node_path.join(userHome(), ".cdx", "apps", "sid", ".env");
}
function readEnvFile() {
  const out = {};
  try {
    for (const line of import_node_fs.readFileSync(envFilePath(), "utf8").split(`
`)) {
      const t = line.trim();
      if (!t || t.startsWith("#") || !t.includes("="))
        continue;
      const i = t.indexOf("=");
      out[t.slice(0, i).trim()] = t.slice(i + 1).trim();
    }
  } catch {}
  return out;
}
function getApiKey() {
  return readEnvFile().SID_API_KEY ?? "";
}
function getBaseUrl() {
  const raw = process.env.CODEXIS_PLUGIN_SID_API_URL || readEnvFile().SID_API_URL || DEFAULT_BASE_URL;
  return raw.trim().replace(/\/+$/, "");
}
function writeEnvFile(entries) {
  const path = envFilePath();
  import_node_fs.mkdirSync(import_node_path.dirname(path), { recursive: true, mode: 448 });
  const body = Object.entries(entries).map(([k, v]) => `${k}=${v}`).join(`
`) + `
`;
  const tmp = `${path}.tmp-${process.pid}`;
  import_node_fs.writeFileSync(tmp, body, { mode: 384 });
  import_node_fs.renameSync(tmp, path);
}
function writeApiKey(key) {
  writeEnvFile({ ...readEnvFile(), SID_API_KEY: key });
}
function deleteApiKey() {
  const rest = readEnvFile();
  delete rest.SID_API_KEY;
  if (Object.keys(rest).length === 0) {
    if (import_node_fs.existsSync(envFilePath()))
      import_node_fs.rmSync(envFilePath());
    return;
  }
  writeEnvFile(rest);
}
var import_node_fs, import_node_path, import_node_os, EXIT, DEFAULT_BASE_URL = "https://sid.codexis.cz";
var init_config = __esm(() => {
  import_node_fs = require("node:fs");
  import_node_path = require("node:path");
  import_node_os = require("node:os");
  EXIT = { OK: 0, ERROR: 1, USAGE: 2, AUTH: 3, NOT_FOUND: 4, RATE_LIMIT: 5 };
});

// src/http.ts
function statusToError(status, bodyText) {
  const detail = bodyText.slice(0, 300);
  if (status === 401) {
    return new CliError(`SID odmítl API klíč (401). Klíč vypršel nebo byl zrušen — vydejte nový na /profile/api-klice. ${detail}`, EXIT.AUTH);
  }
  if (status === 403)
    return new CliError(`Přístup odepřen (403). ${detail}`, EXIT.AUTH);
  if (status === 404)
    return new CliError(`Nenalezeno (404). ${detail}`, EXIT.NOT_FOUND);
  if (status === 429) {
    return new CliError(`Rate limit SID (429) — zpomalte; search je 60 požadavků/min. ${detail}`, EXIT.RATE_LIMIT);
  }
  return new CliError(`SID vrátil HTTP ${status}. ${detail}`, EXIT.ERROR);
}
async function request(path, init, f, keyOverride) {
  const key = keyOverride ?? getApiKey();
  if (!key)
    throw new CliError(NO_KEY_MSG, EXIT.AUTH);
  const res = await f(`${getBaseUrl()}${path}`, {
    ...init,
    signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
    headers: { ...init.headers ?? {}, "x-api-key": key }
  }).catch((e) => {
    const name = e instanceof Error ? e.name : "";
    if (name === "TimeoutError" || name === "AbortError") {
      throw new CliError(`Požadavek na SID vypršel (${REQUEST_TIMEOUT_MS / 1000} s) — server neodpovídá.`, EXIT.ERROR);
    }
    throw new CliError(`SID není dostupný (${e instanceof Error ? e.message : String(e)}).`, EXIT.ERROR);
  });
  if (!res.ok)
    throw statusToError(res.status, await res.text().catch(() => ""));
  return res;
}
async function parseJson(res) {
  const text = await res.text();
  try {
    return JSON.parse(text);
  } catch {
    throw new CliError(`Odpověď ze SID není JSON — zkontrolujte adresu (${getBaseUrl()}); ` + `server vrátil: ${text.slice(0, 120).replace(/\s+/g, " ").trim()}`, EXIT.ERROR);
  }
}
async function apiGet(path, f = fetch, keyOverride) {
  return parseJson(await request(path, {}, f, keyOverride));
}
async function apiPatch(path, body, f = fetch) {
  return parseJson(await request(path, { method: "PATCH", body: JSON.stringify(body), headers: { "content-type": "application/json" } }, f));
}
async function apiRaw(path, f = fetch) {
  return request(path, {}, f);
}
var CliError, NO_KEY_MSG, REQUEST_TIMEOUT_MS = 30000;
var init_http = __esm(() => {
  init_config();
  CliError = class CliError extends Error {
    exitCode;
    constructor(message, exitCode) {
      super(message);
      this.exitCode = exitCode;
    }
  };
  NO_KEY_MSG = "API klíč není nastaven. Vygenerujte si ho v SID (Profil → API klíče, " + "/profile/api-klice) a vložte v nastavení pluginu SID v aplikaci Codexis.";
});

// src/commands/search.ts
var exports_search = {};
__export(exports_search, {
  run: () => run
});
async function run(argv, f) {
  const { values, positionals } = import_node_util.parseArgs({
    args: argv,
    allowPositionals: true,
    options: { size: { type: "string", default: "10" }, from: { type: "string" } }
  });
  const q = positionals.join(" ").trim();
  if (!q)
    throw new CliError("Použití: sid-cli search <dotaz> [--size N] [--from N]", EXIT.USAGE);
  const sp = new URLSearchParams({ q, size: String(values.size) });
  if (values.from)
    sp.set("from", String(values.from));
  const res = await apiGet(`/api/search?${sp}`, f);
  if (res.source === "opensearch_unavailable") {
    return {
      ...res,
      warning: "Fulltext je dočasně nedostupný (opensearch_unavailable) — prázdný výsledek NEZNAMENÁ, " + "že nic neexistuje. Zkuste to později nebo použijte `sid-cli docs list --query`."
    };
  }
  return res;
}
var import_node_util;
var init_search = __esm(() => {
  init_http();
  init_config();
  import_node_util = require("node:util");
});

// src/commands/docs.ts
var exports_docs = {};
__export(exports_docs, {
  run: () => run2
});
async function run2(argv, f) {
  const [sub, ...rest] = argv;
  if (sub === "get") {
    const id = rest[0];
    if (!id)
      throw new CliError(USAGE, EXIT.USAGE);
    return apiGet(`/api/v1/documents/${encodeURIComponent(id)}`, f);
  }
  if (sub === "list") {
    const { values } = import_node_util2.parseArgs({
      args: rest,
      options: {
        query: { type: "string" },
        folder: { type: "string" },
        author: { type: "string" },
        sort: { type: "string" },
        page: { type: "string" },
        "page-size": { type: "string" }
      }
    });
    const sp = new URLSearchParams;
    if (values.query)
      sp.set("query", values.query);
    if (values.folder)
      sp.set("folderId", values.folder);
    if (values.author)
      sp.set("authorId", values.author);
    if (values.sort)
      sp.set("sortBy", values.sort);
    if (values.page)
      sp.set("page", values.page);
    if (values["page-size"])
      sp.set("pageSize", values["page-size"]);
    const qs = sp.toString();
    return apiGet(`/api/v1/documents${qs ? `?${qs}` : ""}`, f);
  }
  throw new CliError(USAGE, EXIT.USAGE);
}
var import_node_util2, USAGE;
var init_docs = __esm(() => {
  init_http();
  init_config();
  import_node_util2 = require("node:util");
  USAGE = "Použití: sid-cli docs list [--query T] [--folder ID] [--author ID] " + "[--sort newest|oldest|title|size] [--page N] [--page-size N] | sid-cli docs get <id>";
});

// src/commands/download.ts
var exports_download = {};
__export(exports_download, {
  run: () => run3
});
function filenameFrom(res, fileId) {
  const cd = res.headers.get("content-disposition") ?? "";
  const m = /filename="?([^";]+)"?/.exec(cd);
  const raw = m?.[1] ?? fileId;
  const safe = import_node_path2.basename(raw.trim().replace(/\\/g, "/"));
  return safe && safe !== "." && safe !== ".." ? safe : import_node_path2.basename(fileId) || "stazeny-soubor";
}
async function run3(argv, f) {
  const { values, positionals } = import_node_util3.parseArgs({
    args: argv,
    allowPositionals: true,
    options: { out: { type: "string" } }
  });
  const fileId = positionals[0];
  if (!fileId)
    throw new CliError("Použití: sid-cli download <fileId> [--out CESTA]", EXIT.USAGE);
  const res = await apiRaw(`/api/files/download/${encodeURIComponent(fileId)}`, f);
  const target = import_node_path2.resolve(values.out ?? filenameFrom(res, fileId));
  if (!res.body)
    throw new CliError("Prázdná odpověď serveru.", EXIT.ERROR);
  import_node_fs2.mkdirSync(import_node_path2.dirname(target), { recursive: true });
  await import_promises.pipeline(import_node_stream.Readable.fromWeb(res.body), import_node_fs2.createWriteStream(target));
  return { savedTo: target, bytes: import_node_fs2.statSync(target).size };
}
var import_node_util3, import_node_fs2, import_node_stream, import_promises, import_node_path2;
var init_download = __esm(() => {
  init_http();
  init_config();
  import_node_util3 = require("node:util");
  import_node_fs2 = require("node:fs");
  import_node_stream = require("node:stream");
  import_promises = require("node:stream/promises");
  import_node_path2 = require("node:path");
});

// src/commands/confirmations.ts
var exports_confirmations = {};
__export(exports_confirmations, {
  run: () => run4
});
async function run4(argv, f) {
  const [sub, ...rest] = argv;
  if (sub === "list") {
    const { values } = import_node_util4.parseArgs({ args: rest, options: { state: { type: "string" } } });
    const qs = values.state ? `?state=${encodeURIComponent(values.state)}` : "";
    return apiGet(`/api/v1/confirmations${qs}`, f);
  }
  if (sub === "confirm") {
    const id = rest[0];
    if (!id)
      throw new CliError(USAGE2, EXIT.USAGE);
    return apiPatch(`/api/v1/confirmations/${encodeURIComponent(id)}`, { state: "CONFIRMED" }, f);
  }
  throw new CliError(USAGE2, EXIT.USAGE);
}
var import_node_util4, USAGE2 = "Použití: sid-cli confirmations list [--state pending|confirmed] | sid-cli confirmations confirm <id>";
