function filenameFrom(res, fileId) {
  const cd = res.headers.get("content-disposition") ?? "";
  const m = /filename="?([^";]+)"?/.exec(cd);
  const raw = m?.[1] ?? fileId;
  const safe = import_node_path2.basename(raw.trim().replace(/\\/g, "/"));
  return safe && safe !== "." && safe !== ".." ? safe : import_node_path2.basename(fileId) || "stazeny-soubor";
}
async function run5(argv, f) {
  const { values, positionals } = import_node_util4.parseArgs({
    args: argv,
    allowPositionals: true,
    options: { out: { type: "string" } }
  });
  const fileId = positionals[0];
  if (!fileId)
    throw new CliError("Použití: sid-cli download <fileId> [--out CESTA]", EXIT.USAGE);
  const res = await apiRaw(`/api/files/download/${encodeURIComponent(fileId)}`, f);
  const target = import_node_path2.resolve(values.out ?? filenameFrom(res, fileId));
  if (!res.body)
    throw new CliError("Prázdná odpověď serveru.", EXIT.ERROR);
  import_node_fs2.mkdirSync(import_node_path2.dirname(target), { recursive: true });
  await import_promises.pipeline(import_node_stream.Readable.fromWeb(res.body), import_node_fs2.createWriteStream(target));
  return { savedTo: target, bytes: import_node_fs2.statSync(target).size };
}
var import_node_util4, import_node_fs2, import_node_stream, import_promises, import_node_path2;
