async function run6(argv, f) {
  const [sub, ...rest] = argv;
  if (sub === "confirm") {
    throw new CliError("Potvrzení se provádí v aplikaci SID, ne z příkazové řádky — " + "otevřete dokument v SID a potvrďte ho tam. " + `Seznam čekajících: ${confirmationsUrl(await resolveRole(f))}`, EXIT.USAGE);
  }
  if (sub === "list") {
    const { values } = import_node_util5.parseArgs({ args: rest, options: { state: { type: "string" } } });
    const qs = values.state ? `?state=${encodeURIComponent(values.state)}` : "";
    const items = await apiGet(`/api/v1/confirmations${qs}`, f);
    const role = await resolveRole(f);
    return {
      confirmations: items.map((c) => c.documentId ? { ...c, url: documentUrl(c.documentId, role) } : c),
      confirmInApp: confirmationsUrl(role)
    };
  }
  throw new CliError(USAGE4, EXIT.USAGE);
}
