#!/usr/bin/env python3
"""onepost-cli - ONEPOST REST API wrapper."""

import argparse
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
CANDIDATES = [
    HERE.parent / "lib",
    Path.home() / ".local/share/onepost/lib",
    Path("/usr/local/share/onepost/lib"),
]
for path in CANDIDATES:
    if (path / "onepost_core").is_dir():
        sys.path.insert(0, str(path))
        break

try:
    from onepost_core import settings
    from onepost_core.api_client import OnepostClient
    from onepost_core.exceptions import OnepostError
except ImportError as e:
    print(f"ERROR: onepost_core library not found: {e}", file=sys.stderr)
    sys.exit(2)


def err(message: str) -> None:
    print(f"ERROR: {message}", file=sys.stderr)


def print_json(payload) -> None:
    print(json.dumps(payload, indent=2, ensure_ascii=False))


def parse_params(values: list[str] | None) -> dict[str, str]:
    params: dict[str, str] = {}
    for item in values or []:
        if "=" not in item:
            raise ValueError(f"Parametr musí mít tvar KEY=VALUE: {item}")
        key, value = item.split("=", 1)
        params[key] = value
    return params


def parse_json_value(value: str):
    if value == "-":
        raw = sys.stdin.read()
    elif value.startswith("@"):
        raw = Path(value[1:]).expanduser().read_text(encoding="utf-8")
    else:
        raw = value
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        raise ValueError(f"Neplatné JSON: {e}") from e


def parse_recipient(value: str) -> dict[str, str]:
    mailbox_id, separator, name = value.partition("=")
    mailbox_id = mailbox_id.strip()
    if not mailbox_id:
        raise ValueError("Příjemce musí mít tvar MAILBOX_ID nebo MAILBOX_ID=JMÉNO.")
    recipient = {"mailboxId": mailbox_id}
    if separator and name.strip():
        recipient["name"] = name.strip()
    return recipient


def clean_payload(payload: dict) -> dict:
    return {key: value for key, value in payload.items() if value is not None}


def client() -> OnepostClient:
    return OnepostClient()


def cmd_mailboxes(args) -> None:
    print_json(client().get_mailboxes(args.include_archive))


def cmd_folders(args) -> None:
    print_json(client().get_folders(args.mailbox_id, args.parent_folder_id))


def cmd_folder_messages(args) -> None:
    print_json(client().get_folder_messages(args.folder_id, args.offset, args.limit, args.order_dir))


def cmd_message(args) -> None:
    print_json(client().get_message(args.message_id, not args.no_attachments))


def cmd_search(args) -> None:
    print_json(client().search_messages(args.query, args.mailbox_id, args.folder_id, args.offset, args.limit))


def cmd_attachments(args) -> None:
    print_json(client().get_attachments(args.message_id))


def cmd_download_attachment(args) -> None:
    print_json(client().download_attachment(args.attachment_id, args.output))


def cmd_receive(args) -> None:
    print_json(client().receive_messages(args.mailbox_id, args.only_headers))


def cmd_upload_attachment(args) -> None:
    print_json(client().upload_attachment(args.path, args.file_name, args.mime_type))


def cmd_concept_save(args) -> None:
    if args.body:
        body = parse_json_value(args.body)
        if not isinstance(body, dict):
            raise ValueError("JSON body pro koncept musí být objekt.")
        print_json(client().save_concept(body))
        return

    if not args.mailbox_id:
        raise ValueError("--mailbox-id je povinný, pokud nepoužijete --body.")

    payload = clean_payload(
        {
            "conceptId": args.concept_id,
            "mailboxId": args.mailbox_id,
            "mailboxUserId": args.mailbox_user_id,
            "subject": args.subject,
            "messageText": args.message_text,
            "recipients": [parse_recipient(recipient) for recipient in args.recipient or []],
            "attachments": args.attachment or [],
            "personalDelivery": args.personal_delivery,
            "disableSubstDelivery": args.disable_subst_delivery,
            "sendAsOVM": args.send_as_ovm,
            "customNote": args.custom_note,
            "toHands": args.to_hands,
            "senderOrgUnit": args.sender_org_unit,
            "senderOrgUnitNum": args.sender_org_unit_num,
            "recipientOrgUnit": args.recipient_org_unit,
            "recipientOrgUnitNum": args.recipient_org_unit_num,
            "recipientRefNumber": args.recipient_ref_number,
            "senderRefNumber": args.sender_ref_number,
            "recipientIdent": args.recipient_ident,
            "senderIdent": args.sender_ident,
            "legalTitleLaw": args.legal_title_law,
            "legalTitleYear": args.legal_title_year,
            "legalTitleSect": args.legal_title_sect,
            "legalTitlePar": args.legal_title_par,
            "legalTitlePoint": args.legal_title_point,
            "forwardMessageId": args.forward_message_id,
            "sendZfo": args.send_zfo,
            "conceptVisibility": args.concept_visibility,
            "emailForwardRecipients": args.email_forward_recipient or [],
        }
    )
    print_json(client().save_concept(payload))


def cmd_concept_send(args) -> None:
    print_json(client().send_concept(args.concept_id))


def cmd_api_get(args) -> None:
    print_json(client().request("GET", args.path, parse_params(args.param)))


def cmd_api_post(args) -> None:
    body = parse_json_value(args.body) if args.body else None
    print_json(client().request("POST", args.path, parse_params(args.param), body))


def cmd_settings_show(args) -> None:
    api_key = settings.read_api_key()
    print_json(
        {
            "apiUrl": settings.read_api_url(),
            "apiKeyConfigured": bool(api_key),
            "apiKeySource": settings.read_api_key_source() or None,
            "apiKey": settings.mask_key(api_key) if api_key else None,
            "settingsFile": settings.ENV_FILE,
        }
    )


def cmd_settings_set(args) -> None:
    key = args.key.strip()
    if not key:
        err("API klíč je prázdný.")
        sys.exit(1)
    OnepostClient(api_key=key).get_mailboxes()
    settings.write_api_key(key)
    print_json({"ok": True, "apiKey": settings.mask_key(key), "settingsFile": settings.ENV_FILE})


def cmd_settings_set_url(args) -> None:
    settings.write_api_url(args.url)
    print_json({"ok": True, "apiUrl": settings.read_api_url(), "settingsFile": settings.ENV_FILE})


def cmd_settings_test(args) -> None:
    result = client().get_mailboxes()
    print_json({"ok": True, "mailboxCount": len(result) if isinstance(result, list) else None})


def add_pagination_args(parser) -> None:
    parser.add_argument("--offset", type=int, default=0)
    parser.add_argument("--limit", type=int, default=20)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="onepost-cli", description="ONEPOST REST API wrapper.")
    sub = parser.add_subparsers(dest="command", required=True)

    p_mailboxes = sub.add_parser("mailboxes", help="List mailboxes")
    p_mailboxes.add_argument("--include-archive", action="store_true")
    p_mailboxes.set_defaults(func=cmd_mailboxes)

    p_folders = sub.add_parser("folders", help="List mailbox folders")
    p_folders.add_argument("mailbox_id")
    p_folders.add_argument("--parent-folder-id")
    p_folders.set_defaults(func=cmd_folders)

    p_folder_messages = sub.add_parser("folder-messages", help="List messages in a folder")
    p_folder_messages.add_argument("folder_id")
    add_pagination_args(p_folder_messages)
    p_folder_messages.add_argument("--order-dir", choices=["asc", "desc"], default="desc")
    p_folder_messages.set_defaults(func=cmd_folder_messages)

    p_message = sub.add_parser("message", help="Get message detail")
    p_message.add_argument("message_id")
    p_message.add_argument("--no-attachments", action="store_true")
    p_message.set_defaults(func=cmd_message)

    p_search = sub.add_parser("search", help="Search messages")
    p_search.add_argument("query")
    p_search.add_argument("--mailbox-id")
    p_search.add_argument("--folder-id")
    add_pagination_args(p_search)
    p_search.set_defaults(func=cmd_search)

    p_attachments = sub.add_parser("attachments", help="List message attachments")
    p_attachments.add_argument("message_id")
    p_attachments.set_defaults(func=cmd_attachments)

    p_download = sub.add_parser("download-attachment", help="Download attachment to a file")
    p_download.add_argument("attachment_id")
    p_download.add_argument("--output", required=True)
    p_download.set_defaults(func=cmd_download_attachment)

    p_receive = sub.add_parser("receive", help="Receive new messages from ISDS")
    p_receive.add_argument("mailbox_id")
    p_receive.add_argument("--only-headers", action="store_true")
    p_receive.set_defaults(func=cmd_receive)

    p_upload_attachment = sub.add_parser("upload-attachment", help="Upload attachment for a concept")
    p_upload_attachment.add_argument("path")
    p_upload_attachment.add_argument("--file-name")
    p_upload_attachment.add_argument("--mime-type")
    p_upload_attachment.set_defaults(func=cmd_upload_attachment)

    p_concept = sub.add_parser("concept", help="Create, update and send concepts")
    concept_sub = p_concept.add_subparsers(dest="concept_command", required=True)

    p_concept_save = concept_sub.add_parser("save", help="Create or update a concept")
    p_concept_save.add_argument("--body", help="JSON request body, raw JSON, @file, or - for stdin")
    p_concept_save.add_argument("--concept-id")
    p_concept_save.add_argument("--mailbox-id")
    p_concept_save.add_argument("--mailbox-user-id")
    p_concept_save.add_argument("--subject")
    p_concept_save.add_argument("--message-text")
    p_concept_save.add_argument("--recipient", action="append", help="Recipient as MAILBOX_ID or MAILBOX_ID=NAME")
    p_concept_save.add_argument("--attachment", action="append", help="Attachment ID from upload endpoint or msg_<id>")
    p_concept_save.add_argument("--personal-delivery", action="store_true")
    p_concept_save.add_argument("--disable-subst-delivery", action="store_true")
    p_concept_save.add_argument("--send-as-ovm", action="store_true")
    p_concept_save.add_argument("--custom-note")
    p_concept_save.add_argument("--to-hands")
    p_concept_save.add_argument("--sender-org-unit")
    p_concept_save.add_argument("--sender-org-unit-num")
    p_concept_save.add_argument("--recipient-org-unit")
    p_concept_save.add_argument("--recipient-org-unit-num")
    p_concept_save.add_argument("--recipient-ref-number")
    p_concept_save.add_argument("--sender-ref-number")
    p_concept_save.add_argument("--recipient-ident")
    p_concept_save.add_argument("--sender-ident")
    p_concept_save.add_argument("--legal-title-law")
    p_concept_save.add_argument("--legal-title-year")
    p_concept_save.add_argument("--legal-title-sect")
    p_concept_save.add_argument("--legal-title-par")
    p_concept_save.add_argument("--legal-title-point")
    p_concept_save.add_argument("--forward-message-id")
    p_concept_save.add_argument("--send-zfo", action="store_true")
    p_concept_save.add_argument("--concept-visibility", choices=["CONCEPT_AUTHOR", "WITHIN_LICENSE"])
    p_concept_save.add_argument("--email-forward-recipient", action="append")
    p_concept_save.set_defaults(func=cmd_concept_save)

    p_concept_send = concept_sub.add_parser("send", help="Synchronously send a concept")
    p_concept_send.add_argument("concept_id")
    p_concept_send.set_defaults(func=cmd_concept_send)

    p_api = sub.add_parser("api", help="Raw ONEPOST API access")
    api_sub = p_api.add_subparsers(dest="api_command", required=True)

    p_api_get = api_sub.add_parser("get", help="GET a relative API path")
    p_api_get.add_argument("path")
    p_api_get.add_argument("--param", action="append", help="Query parameter KEY=VALUE")
    p_api_get.set_defaults(func=cmd_api_get)

    p_api_post = api_sub.add_parser("post", help="POST a relative API path")
    p_api_post.add_argument("path")
    p_api_post.add_argument("--param", action="append", help="Query parameter KEY=VALUE")
    p_api_post.add_argument("--body", help="JSON request body")
    p_api_post.set_defaults(func=cmd_api_post)

    p_settings = sub.add_parser("settings", help="Manage ONEPOST API settings")
    settings_sub = p_settings.add_subparsers(dest="settings_command", required=True)

    p_settings_show = settings_sub.add_parser("show", help="Show current configuration")
    p_settings_show.set_defaults(func=cmd_settings_show)

    p_settings_set = settings_sub.add_parser("set", help="Validate and store API key")
    p_settings_set.add_argument("key")
    p_settings_set.set_defaults(func=cmd_settings_set)

    p_settings_set_url = settings_sub.add_parser("set-url", help="Store ONEPOST API URL")
    p_settings_set_url.add_argument("url")
    p_settings_set_url.set_defaults(func=cmd_settings_set_url)

    p_settings_test = settings_sub.add_parser("test", help="Test current API key")
    p_settings_test.set_defaults(func=cmd_settings_test)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        args.func(args)
        return 0
    except ValueError as e:
        err(str(e))
        return 1
    except OnepostError as e:
        err(str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main())
