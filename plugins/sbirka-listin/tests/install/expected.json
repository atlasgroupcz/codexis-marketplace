{
  "skills": [
    "sbirka-listin:sbirka-listin"
  ],
  "env_vars": [
    "CODEXIS_PLUGIN_SBIRKA_LISTIN_API_URL"
  ],
  "post_install": [
    {
      "type": "file",
      "path": "$HOME/.local/bin/sbirka-listin-cli"
    }
  ],
  "post_uninstall": [
    {
      "type": "absent",
      "path": "$HOME/.local/bin/sbirka-listin-cli"
    }
  ]
}
