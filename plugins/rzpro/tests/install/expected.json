{
  "skills": [
    "rzpro:rzpro"
  ],
  "env_vars": [
    "CODEXIS_PLUGIN_RZPRO_API_URL",
    "CODEXIS_USER_API_TOKEN"
  ],
  "post_install": [
    {
      "type": "file",
      "path": "$HOME/.local/bin/rzpro-cli"
    }
  ],
  "post_uninstall": [
    {
      "type": "absent",
      "path": "$HOME/.local/bin/rzpro-cli"
    }
  ]
}
