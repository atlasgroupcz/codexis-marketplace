{
  "skills": [
    "registr-smluv:registr-smluv"
  ],
  "env_vars": [
    "CODEXIS_PLUGIN_REGISTR_SMLUV_API_URL",
    "CODEXIS_USER_API_TOKEN"
  ],
  "post_install": [
    {
      "type": "file",
      "path": "$HOME/.local/bin/registr-smluv"
    }
  ],
  "post_uninstall": [
    {
      "type": "absent",
      "path": "$HOME/.local/bin/registr-smluv"
    }
  ]
}
