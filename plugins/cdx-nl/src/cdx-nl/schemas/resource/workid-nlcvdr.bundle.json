      "parameters": [
        {
          "name": "workId",
          "in": "path",
          "description": "CVDR work identifier",
          "required": true,
          "schema": { "type": "string" },
          "example": "CVDR101405"
        }
      ],
      "responses": {
        "200": {
          "description": "Resolution",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CvdrWorkIdResponse" }
            }
          }
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "CvdrWorkIdResponse": {
        "type": "object",
        "description": "Resolution of a CVDR work-id to a display document",
        "properties": {
          "workId": { "type": "string", "description": "The CVDR work identifier that was resolved", "example": "CVDR101405" },
          "docId": { "type": "string", "description": "Resolved display ID", "example": "NLCVDR1234" },
          "domain": { "type": "string", "description": "Domain identifier", "example": "lokaleregelgeving_overheid_nl_cvdr" },
          "recordId": { "type": "string", "description": "Internal record ID" },
