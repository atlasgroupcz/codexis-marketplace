{
  "endpoint": "parts",
  "kind": "resource",
  "format": "openapi-fragment",
  "apiDocsUrl": "http://10.245.1.74:8081/v3/api-docs",
  "fetchedAt": "2026-06-22T00:00:00Z",
  "cdxPatterns": [
    "cdx-nl://doc/<NLCVDR_ID>/parts"
  ],
  "operations": [
    {
      "path": "/api/NL/lokaleregelgeving/cvdr/doc/{docId}/parts",
      "method": "get",
      "summary": "Get available parts",
      "description": "List part (article) identifiers for a CVDR document version. Use a part's id as the ?part= filter on /text.",
      "operationId": "getParts",
      "parameters": [
        {
          "name": "docId",
          "in": "path",
          "description": "Document ID",
          "required": true,
          "schema": { "type": "string" },
          "example": "NLCVDR1234"
        },
        {
          "name": "version",
          "in": "query",
          "description": "Manifest expression label. Defaults to the currently valid version.",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "search",
          "in": "query",
          "description": "Filter parts by id/nr/title (case-insensitive substring)",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "offset",
          "in": "query",
          "description": "Pagination offset (default: 0)",
          "required": false,
          "schema": { "type": "integer", "format": "int32" }
        },
        {
          "name": "limit",
          "in": "query",
          "description": "Page size (max: 500)",
          "required": false,
          "schema": { "type": "integer", "format": "int32" }
        }
      ],
      "responses": {
        "200": {
          "description": "Part list",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CvdrPartsResponse" }
            }
          }
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "CvdrPartsResponse": {
        "type": "object",
        "description": "Available parts (articles) in a CVDR document version, parsed from the toestand XML TOC sidecar.",
        "properties": {
          "docId": { "type": "string", "description": "Document ID", "example": "NLCVDR1234" },
          "version": { "type": "string", "description": "Resolved manifest expression label these parts belong to", "example": "2" },
          "totalParts": { "type": "integer", "format": "int32", "description": "Total number of parts after search filtering, before paging" },
          "items": {
            "type": "array",
            "description": "Available parts",
            "items": { "$ref": "#/components/schemas/CvdrPartItem" }
          }
        }
      },
      "CvdrPartItem": {
        "type": "object",
        "description": "An article-level part in a CVDR document",
        "properties": {
          "id": { "type": "string", "description": "Part identifier (use as the 'part' parameter on /text)", "example": "art_3" },
          "nr": { "type": "string", "description": "Article number as cited", "example": "3" },
          "title": { "type": "string", "description": "Article heading title" },
          "kind": { "type": "string", "description": "Structural kind of the entry (e.g. artikel, paragraaf)" },
          "startPage": { "type": "integer", "format": "int32", "description": "1-based page number in the consolidated PDF where this article starts" },
          "startSourceFile": { "type": "string", "description": "Filename of the consolidated PDF this article appears in" }
        }
      }
    }
  }
}
